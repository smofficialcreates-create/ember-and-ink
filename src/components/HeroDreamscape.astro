---
// Ember & Ink — countryside hero. The tree sits on the right so the headline stays clear.
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#d5e6c4]">
  <canvas id="hero-canvas" class="absolute inset-0 z-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-[58%] bg-gradient-to-r from-[#f7f1e4]/80 via-[#f7f1e4]/35 to-transparent"></div>

  <header class="absolute top-0 z-30 flex w-full items-center justify-between px-6 py-6 text-[#3a2218] md:px-12">
    <a href="/" class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
      </svg>
      <span class="font-display text-xl tracking-wide font-medium">Ember & Ink</span>
    </a>
    <nav class="hidden items-center gap-8 text-sm font-medium tracking-wide md:flex">
      <a href="/categories/self-help/" class="hover:text-[#5c1f2c]">Self-Help</a>
      <a href="/categories/fantasy-romance/" class="hover:text-[#5c1f2c]">Fantasy Romance</a>
      <a href="/reviews/" class="hover:text-[#5c1f2c]">Reviews</a>
      <a href="/blog/" class="hover:text-[#5c1f2c]">Blog</a>
      <a href="/about/" class="hover:text-[#5c1f2c]">About</a>
    </nav>
  </header>

  <div id="hero-content" class="container-ember relative z-20 flex h-full flex-col justify-end pb-16 md:justify-center md:pb-0">
    <div class="max-w-xl pl-1 md:pl-8">
      <p class="mb-3 text-xs uppercase tracking-[0.28em] text-[#3c2a22]/70">A countryside library</p>
      <h1 id="hero-title" class="font-display text-5xl leading-[0.95] text-[#3a2218] md:text-7xl">
        Where stories <span class="italic text-[#5c1f2c]">bloom</span>
      </h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-[#3a2a22]/90">
        Step into our Japanese countryside library. Honest reviews for self-help and fantasy romance readers.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/blog/" class="rounded-full bg-[#5c1f2c] px-6 py-3 text-sm font-medium text-[#f7f1e4]">Explore the library</a>
        <a href="/categories/" class="rounded-full border border-[#5c1f2c]/40 bg-[#f7f1e4]/80 px-6 py-3 text-sm font-medium text-[#5c1f2c]">Discover books</a>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("hero-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mobile = window.matchMedia("(max-width: 760px)").matches;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: !mobile, alpha: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.25 : 1.75));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.12;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xc5ddf0);
    scene.fog = new THREE.Fog(0xc5ddf0, 18, 55);

    const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 80);
    camera.position.set(-1.2, 2.15, 9.2);

    scene.add(new THREE.HemisphereLight(0xfff6ea, 0x6f9a55, 0.9));
    const sun = new THREE.DirectionalLight(0xfff1d2, 1.8);
    sun.position.set(-8, 14, 10);
    scene.add(sun);

    const terrGeo = new THREE.PlaneGeometry(70, 46, mobile ? 40 : 80, mobile ? 28 : 50);
    terrGeo.rotateX(-Math.PI / 2);
    const tp = terrGeo.attributes.position;
    for (let i = 0; i < tp.count; i++) {
      const x = tp.getX(i);
      const z = tp.getZ(i);
      let y = Math.exp(-((x - 2.2) ** 2) / 22 - ((z - 0.4) ** 2) / 14) * 1.7;
      y += Math.sin(x * 0.11) * 0.12 + Math.cos(z * 0.09) * 0.08;
      tp.setY(i, y);
    }
    terrGeo.computeVertexNormals();
    const terrMat = new THREE.MeshStandardMaterial({ color: 0x8fbf6a, roughness: 1 });
    scene.add(new THREE.Mesh(terrGeo, terrMat));

    const far = new THREE.Mesh(
      new THREE.SphereGeometry(1, 24, 12),
      new THREE.MeshStandardMaterial({ color: 0xa9c8cf, roughness: 1 }),
    );
    far.scale.set(26, 5.5, 10);
    far.position.set(6, -1.6, -22);
    scene.add(far);

    const tree = new THREE.Group();
    const bark = new THREE.MeshStandardMaterial({ color: 0x6a4330, roughness: 0.9 });
    const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.32, 2.1, 10), bark);
    trunk.position.y = 1.05;
    tree.add(trunk);

    const tips = [];
    const arms = [
      [1.7, 2.7, 0.3], [-1.6, 2.6, 0.1], [0.2, 3.15, -1.15],
      [0.9, 2.55, 1.15], [-0.5, 3.05, 0.85], [1.15, 2.35, -0.75],
      [-1.15, 2.3, -0.55], [0.15, 2.85, 0.15],
    ];
    for (const [x, y, z] of arms) {
      const a = new THREE.Vector3(0, 1.7, 0);
      const b = new THREE.Vector3(x, y, z);
      const mid = a.clone().lerp(b, 0.5);
      mid.y += 0.22;
      tree.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.QuadraticBezierCurve3(a, mid, b), 5, 0.045, 4, false), bark));
      tips.push(b);
    }

    const pink = new THREE.MeshBasicMaterial({ color: 0xf6b7c6 });
    const deep = new THREE.MeshBasicMaterial({ color: 0xe9899e });
    const count = mobile ? 420 : 820;
    const blossoms = new THREE.InstancedMesh(new THREE.SphereGeometry(0.11, 6, 5), pink, count);
    const dummy = new THREE.Object3D();
    for (let i = 0; i < count; i++) {
      const tip = tips[i % tips.length];
      dummy.position.set(
        tip.x + (Math.random() - 0.5) * 1.35,
        tip.y + (Math.random() - 0.55) * 0.7,
        tip.z + (Math.random() - 0.5) * 1.35,
      );
      dummy.scale.setScalar(0.65 + Math.random() * 1.15);
      dummy.updateMatrix();
      blossoms.setMatrixAt(i, dummy.matrix);
    }
    tree.add(blossoms);
    const blossomsDeep = new THREE.InstancedMesh(new THREE.SphereGeometry(0.08, 5, 4), deep, Math.floor(count * 0.35));
    for (let i = 0; i < blossomsDeep.count; i++) {
      const tip = tips[i % tips.length];
      dummy.position.set(tip.x + (Math.random() - 0.5) * 1.1, tip.y - 0.15 + Math.random() * 0.4, tip.z + (Math.random() - 0.5) * 1.1);
      dummy.scale.setScalar(0.7 + Math.random());
      dummy.updateMatrix();
      blossomsDeep.setMatrixAt(i, dummy.matrix);
    }
    tree.add(blossomsDeep);
    tree.position.set(2.6, 1.15, 0.2);
    tree.scale.setScalar(1.25);
    scene.add(tree);

    const petalN = mobile ? 50 : 90;
    const petals = new THREE.InstancedMesh(
      new THREE.CircleGeometry(0.045, 5),
      new THREE.MeshBasicMaterial({ color: 0xf8c5d0, side: THREE.DoubleSide }),
      petalN,
    );
    const petalState = Array.from({ length: petalN }, () => ({
      x: 1.2 + Math.random() * 3.2,
      y: 2.2 + Math.random() * 3.2,
      z: (Math.random() - 0.5) * 2.4,
      s: 0.6 + Math.random() * 0.8,
      spin: Math.random() * 6,
    }));
    scene.add(petals);

    const mouse = { x: 0 };
    window.addEventListener("pointermove", (e) => {
      mouse.x = e.clientX / window.innerWidth - 0.5;
    }, { passive: true });

    const fit = () => {
      const w = canvas.clientWidth || window.innerWidth;
      const h = canvas.clientHeight || window.innerHeight;
      camera.aspect = w / Math.max(h, 1);
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    };
    fit();
    window.addEventListener("resize", fit);

    let running = true;
    document.addEventListener("visibilitychange", () => {
      running = document.visibilityState === "visible";
    });
    const clock = new THREE.Clock();
    const loop = () => {
      requestAnimationFrame(loop);
      if (!running) return;
      const t = reduced ? 0 : clock.getElapsedTime();
      const dt = reduced ? 0 : Math.min(clock.getDelta(), 0.05);
      for (let i = 0; i < petalN; i++) {
        const p = petalState[i];
        if (!reduced) {
          p.y -= dt * (0.22 + p.s * 0.12);
          p.x += Math.sin(t * 0.6 + p.spin) * dt * 0.12;
          p.spin += dt * 0.8;
          if (p.y < 1.15) {
            p.y = 4.6;
            p.x = 1.2 + Math.random() * 3.2;
          }
        }
        dummy.position.set(p.x, p.y, p.z);
        dummy.rotation.set(p.spin, p.spin * 0.4, 0);
        dummy.scale.setScalar(p.s);
        dummy.updateMatrix();
        petals.setMatrixAt(i, dummy.matrix);
      }
      petals.instanceMatrix.needsUpdate = true;
      const sway = reduced ? 0 : mouse.x * 0.45;
      camera.position.x += (-1.2 + sway - camera.position.x) * 0.05;
      camera.lookAt(1.6, 2.05, 0);
      renderer.render(scene, camera);
    };
    loop();
  }
</script>
