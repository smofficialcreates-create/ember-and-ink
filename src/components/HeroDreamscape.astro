---
/**
 * Ember & Ink — HeroDreamscape
 * Cinematic 2.5D illustrated hero inspired by Makoto Shinkai & Studio Ghibli.
 * Features high-res anime art background, live falling cherry blossom petals,
 * mouse parallax, and layout inspired by the reference showcase.
 */
---

<section
  id="hero"
  class="hero-anime relative isolate min-h-[760px] h-[100svh] w-full overflow-hidden bg-[#181124] text-[#fbf6ee]"
  aria-label="Ember and Ink hero"
>
  <!-- ░░ HIGH-RES ILLUSTRATED BACKGROUND WITH 2.5D PARALLAX ░░ -->
  <div class="hero-bg-layer absolute -inset-6 z-0 overflow-hidden pointer-events-none">
    <img
      id="hero-anime-bg"
      src="/images/scenes/sakura-hillside.webp"
      alt="Anime spring morning on Japanese countryside hillside"
      class="w-full h-full object-cover object-center scale-105"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <!-- ░░ CINEMATIC ATMOSPHERIC WASHES (VIGNETTE + GODRAYS) ░░ -->
  <div class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-r from-[#181124]/85 via-[#181124]/40 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-[#120b18] via-transparent to-[#181124]/50"></div>
  
  <!-- Subtle diagonal golden morning light beam -->
  <div class="pointer-events-none absolute -top-40 -left-40 w-[120%] h-[120%] bg-gradient-to-br from-amber-200/15 via-rose-200/5 to-transparent rotate-[-12deg] z-[3] mix-blend-screen"></div>

  <!-- ░░ LIVE FALLING SAKURA PETAL CANVAS ░░ -->
  <canvas
    id="hero-petals-canvas"
    class="pointer-events-none absolute inset-0 z-[4] w-full h-full"
    aria-hidden="true"
  ></canvas>

  <!-- ════════════════════════════════════════════
       MINIMALIST CINEMATIC HEADER (from reference)
  ════════════════════════════════════════════ -->
  <header class="absolute inset-x-0 top-0 z-30 flex items-center justify-between px-6 py-6 md:px-12 md:py-8">
    <!-- Brand wordmark -->
    <a href="/" class="flex items-center gap-3 font-display text-xl md:text-2xl font-semibold tracking-tight text-white group" aria-label="Ember and Ink home">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-white/10 text-[#fbf6ee] backdrop-blur-md shadow-sm group-hover:scale-105 transition-transform">
        <svg viewBox="0 0 32 32" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 8.5c4.2-2 8.2-1.6 12 1.2v16c-3.8-2.8-7.8-3.2-12-1.2zM28 8.5c-4.2-2-8.2-1.6-12 1.2v16c3.8-2.8 7.8-3.2 12-1.2z"/>
          <path d="M8 12.5c2.2-.6 4.1-.3 6 1M24 12.5c-2.2-.6-4.1-.3-6 1"/>
        </svg>
      </span>
      <span class="tracking-wide">Ember <span class="text-[#e8d5a3] font-serif">&amp;</span> Ink</span>
    </a>

    <!-- Minimal nav links -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-medium tracking-widest uppercase text-white/80" aria-label="Primary navigation">
      <a href="/categories/self-help/" class="hover:text-white transition-colors">Self-Help</a>
      <a href="/categories/fantasy-romance/" class="hover:text-white transition-colors">Romantasy</a>
      <a href="/reviews/" class="hover:text-white transition-colors">Reviews</a>
      <a href="/blog/" class="hover:text-white transition-colors">Archive</a>
      <a href="/about/" class="hover:text-white transition-colors">About</a>
      <a
        href="/blog/"
        class="rounded-full border border-white/30 bg-white/10 px-5 py-2 text-white hover:bg-white hover:text-[#181124] backdrop-blur-md transition-all shadow-sm"
      >
        Explore Books
      </a>
    </nav>

    <!-- Mobile menu toggle -->
    <details class="relative md:hidden z-40">
      <summary class="list-none cursor-pointer rounded-full border border-white/25 bg-white/10 px-4 py-2 text-xs uppercase tracking-wider text-white backdrop-blur-md">
        Menu
      </summary>
      <nav class="absolute right-0 mt-3 grid min-w-48 gap-2 rounded-2xl border border-white/20 bg-[#1a1226]/95 p-4 text-xs tracking-wider uppercase text-white shadow-2xl backdrop-blur-2xl">
        <a class="p-2 rounded-lg hover:bg-white/10" href="/categories/self-help/">Self-Help</a>
        <a class="p-2 rounded-lg hover:bg-white/10" href="/categories/fantasy-romance/">Romantasy</a>
        <a class="p-2 rounded-lg hover:bg-white/10" href="/reviews/">Reviews</a>
        <a class="p-2 rounded-lg hover:bg-white/10" href="/blog/">Archive</a>
        <a class="p-2 rounded-lg hover:bg-white/10" href="/about/">About</a>
      </nav>
    </details>
  </header>

  <!-- ════════════════════════════════════════════
       CINEMATIC HERO EDITORIAL CONTENT (Reference Layout)
  ════════════════════════════════════════════ -->
  <div class="container-ember relative z-20 flex h-full items-center pt-24 pb-20 md:py-0">
    <div class="max-w-[44rem]">
      
      <!-- Eyebrow with symbol -->
      <div class="hero-eyebrow mb-5 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.28em] text-[#e8d5a3] drop-shadow-sm">
        <span>⛩</span>
        <span>A Sanctuary Between Pages · Japanese Countryside Archive</span>
      </div>

      <!-- Monumental Editorial Title (like VISITE from reference) -->
      <h1 class="hero-title font-display text-[clamp(3.8rem,9vw,8.5rem)] font-bold tracking-[-0.04em] text-white leading-[0.92] drop-shadow-[0_8px_32px_rgba(0,0,0,0.6)]">
        EMBER <span class="text-[#e8d5a3]">&amp;</span> INK
        <span class="block font-normal italic font-serif text-[clamp(2.4rem,5.5vw,5rem)] tracking-normal text-[#ffcad4] mt-2">
          Where stories bloom.
        </span>
      </h1>

      <!-- Editorial Narrative Paragraph -->
      <p class="hero-subtext mt-7 max-w-xl text-base md:text-lg leading-relaxed text-[#fbf6ee]/85 font-light drop-shadow-md">
        Away from the frantic noise of modern life lies a quiet hillside sanctuary. Curated reviews for readers who seek grounding wisdom in self-help and sweeping escapes in romantasy.
      </p>

      <!-- Action Button Row (styled from reference video) -->
      <div class="hero-cta-row mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#tranquility-shelf"
          class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-white px-8 py-3.5 text-xs font-bold uppercase tracking-widest text-[#181124] shadow-[0_12px_32px_rgba(0,0,0,0.35)] transition-all duration-300 hover:bg-[#e8d5a3] hover:scale-105"
        >
          <span>Start the journey</span>
          <span aria-hidden="true">▶</span>
        </a>
        <a
          href="/blog/"
          class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 bg-white/10 px-8 py-3.5 text-xs font-semibold uppercase tracking-widest text-white backdrop-blur-md transition-all duration-300 hover:bg-white/20"
        >
          Browse All Reviews
        </a>
      </div>

    </div>
  </div>

  <!-- ════════════════════════════════════════════
       TIMELINE / SCENE INDICATOR (from reference video)
  ════════════════════════════════════════════ -->
  <div class="absolute bottom-8 inset-x-0 z-20 px-6 md:px-12 flex items-center justify-between text-xs font-mono text-white/60">
    <div class="flex items-center gap-4">
      <span class="text-[#e8d5a3] font-semibold">00:01</span>
      <div class="w-32 md:w-56 h-1 rounded-full bg-white/20 overflow-hidden relative">
        <div class="absolute inset-y-0 left-0 w-1/7 bg-[#e8d5a3] rounded-full"></div>
      </div>
      <span>00:07</span>
      <span class="hidden sm:inline text-white/40">·</span>
      <span class="hidden sm:inline uppercase tracking-widest text-[11px] text-white/70">Scene I: Spring Hillside</span>
    </div>

    <div class="flex items-center gap-2 uppercase tracking-widest text-[11px] text-white/70">
      <span>Scroll to explore</span>
      <span class="animate-bounce">↓</span>
    </div>
  </div>
</section>

<script>
  import { mountSakuraPetals } from '../scripts/anime-particles.js';
  import gsap from 'gsap';

  // Mount sakura petals
  const canvas = document.getElementById('hero-petals-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    mountSakuraPetals(canvas);
  }

  // 2.5D Mouse Parallax on illustrated background (desktop fine-pointer only to keep mobile touch scroll native & silky smooth)
  const bg = document.getElementById('hero-anime-bg');
  const hero = document.getElementById('hero');
  const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (bg && hero && isFinePointer && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      const xNorm = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      const yNorm = ((e.clientY - rect.top) / rect.height - 0.5) * 2;

      gsap.to(bg, {
        x: xNorm * -18,
        y: yNorm * -14,
        duration: 1.2,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    }, { passive: true });
  }

  // GSAP Entrance
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.from('.hero-eyebrow', { opacity: 0, y: 20, duration: 1, delay: 0.2, ease: 'power3.out' });
    gsap.from('.hero-title', { opacity: 0, y: 35, duration: 1.2, delay: 0.35, ease: 'power3.out' });
    gsap.from('.hero-subtext', { opacity: 0, y: 25, duration: 1, delay: 0.6, ease: 'power3.out' });
    gsap.from('.hero-cta-row', { opacity: 0, y: 20, duration: 1, delay: 0.75, ease: 'power3.out' });
  }
</script>
