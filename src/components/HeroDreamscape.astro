---
// Ember & Ink — Fully Modelled 3D Japanese Countryside Engine
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#87b3cf]">
  <!-- 3D Canvas -->
  <canvas id="webgl-hero" class="absolute inset-0 w-full h-full outline-none"></canvas>

  <!-- UI Overlay -->
  <div class="absolute inset-0 z-20 pointer-events-none">
    <div class="container-ember h-full flex flex-col justify-center pt-20">
      <div class="max-w-xl text-[#FBF6EE] pointer-events-auto drop-shadow-2xl">
        <p class="text-sm uppercase tracking-[0.3em] text-[#ffedd5] font-semibold mb-6 opacity-0 translate-y-8" id="hero-subtitle">
          An immersive literary experience
        </p>
        <h1 class="font-display text-6xl md:text-8xl leading-[1.05] opacity-0 translate-y-8" id="hero-title">
          Where stories <br/>
          <span class="italic text-[#ffb7c5] drop-shadow-[0_0_15px_rgba(255,183,197,0.5)]">bloom.</span>
        </h1>
        <p class="mt-6 text-lg text-[#FBF6EE]/90 font-medium max-w-md opacity-0 translate-y-8" id="hero-desc">
          Step into our Japanese countryside library. Honest reviews for self-help and fantasy romance readers.
        </p>
        <div class="mt-10 flex gap-4 opacity-0 translate-y-8" id="hero-buttons">
          <a href="/blog/" class="rounded-full bg-[#5B1F2A] text-[#FBF6EE] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(91,31,42,0.5)] hover:bg-[#451722] hover:-translate-y-1 transition-all duration-300">
            Explore the Library
          </a>
          <a href="/categories/" class="rounded-full bg-[#C9A227] text-[#2B2118] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(201,162,39,0.5)] hover:bg-[#E8D9A8] hover:-translate-y-1 transition-all duration-300">
            Discover Books
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Gradient overlay to smoothly fade into the rest of the page -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#fbf6ee] to-transparent z-10 pointer-events-none"></div>
</section>

<script>
  import gsap from 'gsap';
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    // --- UI Entrance Animation ---
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
    tl.to('#hero-subtitle', { opacity: 1, y: 0, duration: 1.2, delay: 0.2 })
      .to('#hero-title', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-desc', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-buttons', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9');

    // --- 3D Scene Setup ---
    const canvas = document.getElementById('webgl-hero');
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0xc5d8e8, 0.008); // Atmospheric mist

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 6, 25);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // --- Lighting (Cinematic Morning Sun) ---
    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x4a6b4a, 1.2);
    scene.add(hemiLight);

    const sunLight = new THREE.DirectionalLight(0xfff2d9, 2.5);
    sunLight.position.set(30, 40, 20);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 1;
    sunLight.shadow.camera.far = 100;
    sunLight.shadow.camera.left = -40;
    sunLight.shadow.camera.right = 40;
    sunLight.shadow.camera.top = 40;
    sunLight.shadow.camera.bottom = -40;
    sunLight.shadow.bias = -0.001;
    scene.add(sunLight);

    const fillLight = new THREE.DirectionalLight(0x8ab4f8, 0.5);
    fillLight.position.set(-20, 10, -20);
    scene.add(fillLight);

    // --- Procedural Environment ---
    
    // 1. Ground (Rolling Hills)
    const groundGeo = new THREE.PlaneGeometry(200, 200, 64, 64);
    const pos = groundGeo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i);
      const y = pos.getY(i);
      const z = Math.sin(x * 0.1) * Math.cos(y * 0.1) * 3 + Math.sin(x * 0.05) * 5 - 5;
      pos.setZ(i, z);
    }
    groundGeo.computeVertexNormals();
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x6da35a, roughness: 0.9 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -5;
    ground.receiveShadow = true;
    scene.add(ground);

    // 2. River
    const riverGeo = new THREE.PlaneGeometry(15, 100);
    const riverMat = new THREE.MeshStandardMaterial({ 
      color: 0x6eb5d9, 
      roughness: 0.1, 
      metalness: 0.6,
      transparent: true,
      opacity: 0.8
    });
    const river = new THREE.Mesh(riverGeo, riverMat);
    river.rotation.x = -Math.PI / 2;
    river.position.set(10, -4, -20);
    river.receiveShadow = true;
    scene.add(river);

    // 3. Cherry Blossom Tree (Procedural)
    const treeGroup = new THREE.Group();
    treeGroup.position.set(-8, -3, -5);
    
    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x3b2b20, roughness: 1 });
    const blossomMat = new THREE.MeshStandardMaterial({ color: 0xffb7c5, roughness: 0.7, flatShading: true });

    function createBranch(startPos, rotation, length, radius, depth) {
      if (depth === 0) return;
      
      const branchGeo = new THREE.CylinderGeometry(radius * 0.7, radius, length, 6);
      branchGeo.translate(0, length / 2, 0); // Origin at bottom
      const branch = new THREE.Mesh(branchGeo, trunkMat);
      branch.position.copy(startPos);
      branch.rotation.copy(rotation);
      branch.castShadow = true;
      branch.receiveShadow = true;
      treeGroup.add(branch);

      // Calculate end position for the next branch
      const endPos = new THREE.Vector3(0, length, 0);
      endPos.applyEuler(rotation);
      endPos.add(startPos);

      // Add Blossom Clusters
      if (depth <= 2) {
        const clusterGeo = new THREE.IcosahedronGeometry(1.5, 1);
        const cluster = new THREE.Mesh(clusterGeo, blossomMat);
        cluster.position.copy(endPos);
        cluster.castShadow = true;
        
        // Randomize blossom shape slightly
        cluster.scale.set(1 + Math.random(), 1 + Math.random(), 1 + Math.random());
        treeGroup.add(cluster);
      }

      // Recursive branches
      const numBranches = depth > 2 ? 3 : 2;
      for (let i = 0; i < numBranches; i++) {
        const newRot = new THREE.Euler(
          rotation.x + (Math.random() - 0.5) * 1.5,
          rotation.y + (Math.random() - 0.5) * 2,
          rotation.z + (Math.random() - 0.5) * 1.5
        );
        createBranch(endPos, newRot, length * 0.7, radius * 0.7, depth - 1);
      }
    }
    
    // Start tree
    createBranch(new THREE.Vector3(0, 0, 0), new THREE.Euler(0, 0, 0), 8, 1.2, 5);
    scene.add(treeGroup);

    // 4. Reading Corner (Chair, Table, Book, Lamp)
    const furnitureGroup = new THREE.Group();
    furnitureGroup.position.set(-4, -3.8, 2);
    
    const woodMat = new THREE.MeshStandardMaterial({ color: 0x5c3a21, roughness: 0.8 });
    const paperMat = new THREE.MeshStandardMaterial({ color: 0xfbf6ee, roughness: 1 });
    const goldMat = new THREE.MeshStandardMaterial({ color: 0xc9a227, metalness: 0.8, roughness: 0.2 });
    const lampMat = new THREE.MeshStandardMaterial({ color: 0x2b1b12, roughness: 0.5 });

    // Chair
    const chairSeat = new THREE.Mesh(new THREE.BoxGeometry(2, 0.2, 2), woodMat);
    chairSeat.position.y = 1.5; chairSeat.castShadow = true; chairSeat.receiveShadow = true;
    furnitureGroup.add(chairSeat);
    const chairBack = new THREE.Mesh(new THREE.BoxGeometry(2, 2.5, 0.2), woodMat);
    chairBack.position.set(0, 2.75, -0.9); chairBack.castShadow = true;
    furnitureGroup.add(chairBack);
    const legGeo = new THREE.CylinderGeometry(0.1, 0.1, 1.5);
    [[-0.8, -0.8], [0.8, -0.8], [-0.8, 0.8], [0.8, 0.8]].forEach(pos => {
      const leg = new THREE.Mesh(legGeo, woodMat);
      leg.position.set(pos[0], 0.75, pos[1]); leg.castShadow = true;
      furnitureGroup.add(leg);
    });

    // Table
    const tableTop = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.2, 1.5), woodMat);
    tableTop.position.set(2.5, 1.5, 0); tableTop.castShadow = true; tableTop.receiveShadow = true;
    furnitureGroup.add(tableTop);
    [[1.4, -0.5], [3.6, -0.5], [1.4, 0.5], [3.6, 0.5]].forEach(pos => {
      const leg = new THREE.Mesh(legGeo, woodMat);
      leg.position.set(pos[0], 0.75, pos[1]); leg.castShadow = true;
      furnitureGroup.add(leg);
    });

    // Book on Table
    const bookCover = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.1, 1.6), goldMat);
    bookCover.position.set(2.5, 1.65, 0); bookCover.rotation.y = 0.2; bookCover.castShadow = true;
    const bookPages = new THREE.Mesh(new THREE.BoxGeometry(1.1, 0.08, 1.5), paperMat);
    bookPages.position.set(2.5, 1.65, 0); bookPages.rotation.y = 0.2;
    furnitureGroup.add(bookCover); furnitureGroup.add(bookPages);

    // Vintage Lamp
    const lampPole = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 3), lampMat);
    lampPole.position.set(4, 3, 0); lampPole.castShadow = true;
    furnitureGroup.add(lampPole);
    const lampShade = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.6, 0.8, 8), paperMat);
    lampShade.position.set(4, 4.4, 0);
    furnitureGroup.add(lampShade);
    
    // Lamp Light
    const lampLight = new THREE.PointLight(0xffaa55, 2, 10);
    lampLight.position.set(4, 4, 0);
    furnitureGroup.add(lampLight);

    scene.add(furnitureGroup);

    // 5. Distant Train
    const trainGroup = new THREE.Group();
    const trainBodyMat = new THREE.MeshStandardMaterial({ color: 0xe0e0e0, roughness: 0.4 });
    const trainWindowMat = new THREE.MeshStandardMaterial({ color: 0x333333, roughness: 0.1 });
    for (let i = 0; i < 3; i++) {
      const car = new THREE.Mesh(new THREE.BoxGeometry(6, 2.5, 2), trainBodyMat);
      car.position.set(i * 6.5, 0, 0);
      const win = new THREE.Mesh(new THREE.BoxGeometry(5, 1, 2.1), trainWindowMat);
      win.position.set(i * 6.5, 0.5, 0);
      trainGroup.add(car);
      trainGroup.add(win);
    }
    trainGroup.position.set(-40, 1, -30);
    scene.add(trainGroup);

    // 6. Falling Petals (InstancedMesh)
    const petalCount = 400;
    const petalGeo = new THREE.PlaneGeometry(0.4, 0.4);
    const petalMat = new THREE.MeshStandardMaterial({
      color: 0xffb7c5, side: THREE.DoubleSide, transparent: true, opacity: 0.9
    });
    const instancedPetals = new THREE.InstancedMesh(petalGeo, petalMat, petalCount);
    scene.add(instancedPetals);

    const dummy = new THREE.Object3D();
    const petalsData = [];
    for (let i = 0; i < petalCount; i++) {
      petalsData.push({
        x: (Math.random() - 0.5) * 60,
        y: Math.random() * 30,
        z: (Math.random() - 0.5) * 40 - 5,
        rotX: Math.random() * Math.PI,
        rotY: Math.random() * Math.PI,
        rotZ: Math.random() * Math.PI,
        speedY: Math.random() * 0.02 + 0.01,
        speedX: Math.random() * 0.02 - 0.01,
        swing: Math.random() * Math.PI
      });
    }

    // --- Mouse Parallax ---
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    
    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth) - 0.5;
      mouseY = (e.clientY / window.innerHeight) - 0.5;
      targetX = mouseX * 5;
      targetY = mouseY * 3;
    });

    // --- Animation Loop ---
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const time = clock.getElapsedTime();

      // Camera Parallax
      camera.position.x += (targetX - camera.position.x) * 0.05;
      camera.position.y += (6 - targetY - camera.position.y) * 0.05;
      camera.lookAt(0, 3, -10);

      // Train Movement
      trainGroup.position.x += 0.08;
      if (trainGroup.position.x > 50) trainGroup.position.x = -60;

      // River water ripple (animate texture offset or material color slightly)
      riverMat.color.setHSL(0.55, 0.4, 0.5 + Math.sin(time * 2) * 0.05);

      // Petals Animation
      for (let i = 0; i < petalCount; i++) {
        const p = petalsData[i];
        p.y -= p.speedY;
        p.swing += 0.02;
        p.x += p.speedX + Math.sin(p.swing) * 0.02;
        p.rotX += 0.01;
        p.rotY += 0.02;

        if (p.y < -5) {
          p.y = 30;
          p.x = (Math.random() - 0.5) * 60;
        }

        dummy.position.set(p.x, p.y, p.z);
        dummy.rotation.set(p.rotX, p.rotY, p.rotZ);
        dummy.updateMatrix();
        instancedPetals.setMatrixAt(i, dummy.matrix);
      }
      instancedPetals.instanceMatrix.needsUpdate = true;

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  });
</script>
