---
// Ember & Ink — Immersive Anime Dreamscape Hero
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#E5F0F5]">
  <!-- 1. Parallax Background Layers -->
  <div class="absolute inset-0 z-0 pointer-events-none" id="parallax-container">
    <!-- Sky/Gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#B8D8E6] to-[#FDF5E6]"></div>
    
    <!-- Distant Mountains -->
    <svg class="absolute bottom-[20%] w-full h-[50vh] text-[#7C9A92] opacity-60" layer-speed="0.1" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="currentColor" d="M0,192L48,176C96,160,192,128,288,138.7C384,149,480,203,576,213.3C672,224,768,192,864,165.3C960,139,1056,117,1152,122.7C1248,128,1344,160,1392,176L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>

    <!-- Rolling Hills -->
    <svg class="absolute bottom-0 w-full h-[40vh] text-[#5A7A52]" layer-speed="0.3" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="currentColor" d="M0,224L60,213.3C120,203,240,181,360,192C480,203,600,245,720,245.3C840,245,960,203,1080,181.3C1200,160,1320,160,1380,160L1440,160L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path>
    </svg>

    <!-- Foreground Grass -->
    <svg class="absolute bottom-0 w-full h-[20vh] text-[#425A3B]" layer-speed="0.6" viewBox="0 0 1440 320" preserveAspectRatio="none">
      <path fill="currentColor" d="M0,288L48,272C96,256,192,224,288,218.7C384,213,480,235,576,250.7C672,267,768,277,864,266.7C960,256,1056,224,1152,218.7C1248,213,1344,235,1392,245.3L1440,256L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
    </svg>
  </div>

  <!-- 2. Canvas for Cherry Blossom Petals -->
  <canvas id="sakura-canvas" class="absolute inset-0 z-10 pointer-events-none"></canvas>

  <!-- 3. Content and 3D Book -->
  <div class="relative z-20 container-ember h-full flex items-center justify-between">
    <!-- Text Content -->
    <div class="max-w-xl text-[#2B2118]">
      <p class="text-sm uppercase tracking-[0.3em] text-[#5B1F2A] font-semibold mb-4 opacity-0" id="hero-subtitle">
        Enter a literary dreamscape
      </p>
      <h1 class="font-display text-5xl md:text-7xl leading-[1.1] text-[#3E4A38] opacity-0" id="hero-title">
        Where stories <br/>
        <span class="italic text-[#B5654A]">bloom.</span>
      </h1>
      <p class="mt-6 text-lg text-[#5A7A52] font-medium max-w-md opacity-0" id="hero-desc">
        Honest reviews for self-help and fantasy romance readers. 
        Find your next escape in our curated library.
      </p>
      <div class="mt-10 flex gap-4 opacity-0" id="hero-buttons">
        <a href="/blog/" class="rounded-full bg-[#5B1F2A] text-[#FBF6EE] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(91,31,42,0.3)] hover:bg-[#451722] hover:-translate-y-1 transition-all duration-300">
          Explore the Library
        </a>
        <a href="/categories/" class="rounded-full bg-[#C9A227] text-[#2B2118] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(201,162,39,0.3)] hover:bg-[#E8D9A8] hover:-translate-y-1 transition-all duration-300">
          Discover Books
        </a>
      </div>
    </div>

    <!-- 3D Floating Book -->
    <div class="hidden lg:block relative w-[400px] h-[600px] perspective-[1500px]" id="book-container">
      <div class="w-full h-full relative preserve-3d transition-transform duration-200 ease-out" id="3d-book">
        <!-- Book Cover -->
        <div class="absolute inset-0 bg-[#5B1F2A] rounded-r-xl rounded-l-sm shadow-[-20px_20px_40px_rgba(0,0,0,0.4)] border-l-[12px] border-[#451722] flex flex-col items-center justify-center p-8 overflow-hidden">
          <!-- Book Art -->
          <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cream-paper.png')]"></div>
          <div class="w-24 h-1 bg-[#C9A227] mb-8"></div>
          <h2 class="font-display text-4xl text-[#FBF6EE] text-center leading-tight relative z-10">Ember<br/>&amp;<br/>Ink</h2>
          <p class="font-display text-[#C9A227] italic mt-6 relative z-10">The 2026 Collection</p>
          <div class="w-16 h-1 bg-[#C9A227] mt-8"></div>
        </div>
        <!-- Book Spine depth effect -->
        <div class="absolute top-0 bottom-0 left-0 w-[12px] bg-[#3d121b] transform rotateY(-90deg) origin-left"></div>
      </div>
      <!-- Glowing orb behind book -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-[#C9A227] rounded-full blur-[100px] opacity-40 -z-10 animate-pulse"></div>
    </div>
  </div>
</section>

<style>
  /* CSS for 3D Book */
  .perspective-\[1500px\] { perspective: 1500px; }
  .preserve-3d { transform-style: preserve-3d; }
  
  /* Floating animation for book */
  @keyframes float {
    0% { transform: translateY(0px) rotateY(-15deg) rotateX(10deg); }
    50% { transform: translateY(-20px) rotateY(-10deg) rotateX(5deg); }
    100% { transform: translateY(0px) rotateY(-15deg) rotateX(10deg); }
  }
  #3d-book {
    animation: float 6s ease-in-out infinite;
    transform-style: preserve-3d;
  }
</style>

<script>
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Cinematic Entrance Animation
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    
    tl.to('#hero-subtitle', { opacity: 1, y: 0, duration: 1, delay: 0.5 })
      .to('#hero-title', { opacity: 1, y: 0, duration: 1 }, '-=0.7')
      .to('#hero-desc', { opacity: 1, y: 0, duration: 1 }, '-=0.7')
      .to('#hero-buttons', { opacity: 1, y: 0, duration: 1 }, '-=0.7')
      .from('#book-container', { opacity: 0, x: 100, rotationY: -30, duration: 1.5 }, '-=1');

    // Initial states for entrance
    gsap.set(['#hero-subtitle', '#hero-title', '#hero-desc', '#hero-buttons'], { y: 30 });

    // 2. Mouse Parallax for Landscape
    const container = document.getElementById('parallax-container');
    const layers = document.querySelectorAll('[layer-speed]');

    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;

      layers.forEach(layer => {
        const speed = parseFloat(layer.getAttribute('layer-speed'));
        gsap.to(layer, {
          x: x * speed * 50,
          y: y * speed * 20,
          duration: 1,
          ease: 'power2.out'
        });
      });
    });

    // 3. 3D Book Tilt Interaction
    const book = document.getElementById('3d-book');
    const bookContainer = document.getElementById('book-container');

    if (book && bookContainer) {
      bookContainer.addEventListener('mousemove', (e) => {
        const rect = bookContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -20; 
        const rotateY = ((x - centerX) / centerX) * 20;

        gsap.to(book, {
          rotationX: rotateX,
          rotationY: rotateY,
          duration: 0.5,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });

      bookContainer.addEventListener('mouseleave', () => {
        gsap.to(book, {
          rotationX: 10,
          rotationY: -15,
          duration: 1,
          ease: 'power3.out'
        });
      });
    }

    // 4. Cherry Blossom Petals Canvas
    const canvas = document.getElementById('sakura-canvas');
    const ctx = canvas.getContext('2d');
    let width, height;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const petals = [];
    const petalCount = 40;

    class Petal {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * width;
        this.y = Math.random() * -height;
        this.size = Math.random() * 8 + 5;
        this.speedY = Math.random() * 1.5 + 0.5;
        this.speedX = Math.random() * 1 - 0.5;
        this.rotation = Math.random() * 360;
        this.rotationSpeed = Math.random() * 2 - 1;
        this.opacity = Math.random() * 0.5 + 0.3;
        this.swing = Math.random() * 2;
        this.swingSpeed = Math.random() * 0.02;
      }
      update() {
        this.y += this.speedY;
        this.swing += this.swingSpeed;
        this.x += this.speedX + Math.sin(this.swing) * 1;
        this.rotation += this.rotationSpeed;
        if (this.y > height + 20 || this.x > width + 20 || this.x < -20) {
          this.reset();
          this.y = -20; // start above screen
        }
      }
      draw() {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rotation * Math.PI / 180);
        ctx.beginPath();
        ctx.ellipse(0, 0, this.size, this.size / 2, 0, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 183, 197, ${this.opacity})`;
        ctx.fill();
        ctx.restore();
      }
    }

    for (let i = 0; i < petalCount; i++) {
      petals.push(new Petal());
    }

    function animatePetals() {
      ctx.clearRect(0, 0, width, height);
      petals.forEach(petal => {
        petal.update();
        petal.draw();
      });
      requestAnimationFrame(animatePetals);
    }
    animatePetals();
  });
</script>
