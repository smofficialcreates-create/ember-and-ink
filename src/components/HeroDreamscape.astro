---
/**
 * Ember & Ink — immersive countryside hero.
 * The scene renderer lives in src/scripts/hero-scene.js so geometry,
 * materials and animation remain separate from the accessible HTML.
 */
---

<section id="hero" class="hero-dreamscape relative isolate min-h-[760px] h-[100svh] w-full overflow-hidden bg-[#c6dce0]">
  <canvas
    id="hero-canvas"
    class="absolute inset-0 z-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <div class="hero-wash pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>

  <header class="absolute inset-x-0 top-0 z-30 flex items-center justify-between px-5 py-5 text-[#302d27] md:px-10 md:py-7">
    <a href="/" class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight md:text-2xl" aria-label="Ember and Ink home">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-[#715d47]/30 bg-[#fffaf0]/65 text-[#5b1f2a] backdrop-blur-sm">
        <svg viewBox="0 0 32 32" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 8.5c4.2-2 8.2-1.6 12 1.2v16c-3.8-2.8-7.8-3.2-12-1.2zM28 8.5c-4.2-2-8.2-1.6-12 1.2v16c3.8-2.8 7.8-3.2 12-1.2z"/>
          <path d="M8 12.5c2.2-.6 4.1-.3 6 1M24 12.5c-2.2-.6-4.1-.3-6 1"/>
        </svg>
      </span>
      <span>Ember <span class="text-[#a47a48]">&amp;</span> Ink</span>
    </a>

    <nav class="hidden items-center gap-7 rounded-full border border-white/35 bg-[#f8f4e9]/55 px-6 py-3 text-[13px] font-medium tracking-wide text-[#34352f] shadow-sm backdrop-blur-md md:flex" aria-label="Primary navigation">
      <a href="/categories/self-help/" class="transition-colors hover:text-[#7a3742]">Self-Help</a>
      <a href="/categories/fantasy-romance/" class="transition-colors hover:text-[#7a3742]">Fantasy Romance</a>
      <a href="/reviews/" class="transition-colors hover:text-[#7a3742]">Reviews</a>
      <a href="/blog/" class="transition-colors hover:text-[#7a3742]">Blog</a>
      <a href="/faq/" class="transition-colors hover:text-[#7a3742]">FAQ</a>
      <a href="/about/" class="transition-colors hover:text-[#7a3742]">About</a>
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-[#695846]/25 bg-[#fffaf0]/65 px-4 py-2 text-sm font-medium text-[#302d27] backdrop-blur-sm">Menu</summary>
      <nav class="absolute right-0 mt-2 grid min-w-48 gap-1 rounded-2xl border border-white/60 bg-[#faf7ee]/95 p-3 text-sm shadow-xl backdrop-blur-xl" aria-label="Mobile navigation">
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/categories/self-help/">Self-Help</a>
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/categories/fantasy-romance/">Fantasy Romance</a>
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/reviews/">Reviews</a>
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/blog/">Blog</a>
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/faq/">FAQ</a>
        <a class="rounded-lg px-3 py-2 hover:bg-white/70" href="/about/">About</a>
      </nav>
    </details>
  </header>

  <div id="hero-content" class="container-ember relative z-20 flex h-full items-start pb-24 pt-40 md:items-center md:pb-10 md:pt-16">
    <div class="hero-copy max-w-[38rem] rounded-[1.75rem] px-1 py-2 md:px-0">
      <p class="mb-5 text-[11px] font-semibold uppercase tracking-[0.34em] text-[#655f50] md:text-xs">
        A countryside library
      </p>
      <h1 id="hero-title" class="font-display text-[clamp(3.5rem,7vw,6.7rem)] leading-[0.91] tracking-[-0.055em] text-[#2f332c]">
        Where stories <span class="block italic font-normal text-[#9b5960]">bloom.</span>
      </h1>
      <p class="mt-7 max-w-[29rem] text-[15px] leading-7 text-[#3d4037] md:text-lg md:leading-8">
        Step into our Japanese countryside library. Honest reviews for self-help and fantasy romance readers.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/blog/" class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#56303a] px-7 py-3 text-sm font-semibold text-[#fff9ed] shadow-[0_10px_30px_rgba(47,43,34,.18)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#40232b]">
          Explore the library <span aria-hidden="true">↗</span>
        </a>
        <a href="/categories/" class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#5b5142]/35 bg-[#fffaf0]/60 px-7 py-3 text-sm font-semibold text-[#40382f] backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:bg-[#fffaf0]/85">
          Discover books
        </a>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute bottom-7 right-8 z-20 hidden items-center gap-3 text-[10px] uppercase tracking-[0.25em] text-[#45564e]/80 md:flex">
    <span class="h-px w-10 bg-current"></span>
    A quieter kind of escape
  </div>
</section>

<script>
  import { mountHeroScene } from "../scripts/hero-scene.js";

  const canvas = document.getElementById("hero-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    mountHeroScene(canvas);
  }
</script>

<style>
  .hero-dreamscape {
    min-height: 760px;
    height: 100svh;
    isolation: isolate;
  }

  .hero-wash {
    background:
      linear-gradient(90deg, rgba(248, 246, 235, 0.66) 0%, rgba(248, 246, 235, 0.46) 27%, rgba(248, 246, 235, 0.12) 54%, rgba(248, 246, 235, 0) 72%),
      linear-gradient(180deg, rgba(242, 245, 235, 0.16) 0%, transparent 24%, transparent 70%, rgba(38, 55, 42, 0.12) 100%);
  }

  @media (max-width: 760px) {
    .hero-dreamscape {
      min-height: 820px;
      height: 100svh;
    }

    .hero-wash {
      background:
        linear-gradient(180deg, rgba(248, 246, 235, 0.48) 0%, rgba(248, 246, 235, 0.30) 40%, rgba(248, 246, 235, 0.04) 100%),
        linear-gradient(90deg, rgba(248, 246, 235, 0.30), transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-copy * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
