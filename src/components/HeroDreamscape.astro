---
// Ember & Ink — Cinematic Anime Hero Engine
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#0a0b10]">
  
  <div id="bg-parallax" class="absolute inset-0 z-0 w-[110%] h-[110%] -left-[5%] -top-[5%] will-change-transform">
    <img 
      src="https://images.unsplash.com/photo-1522383225653-ed111181a951?q=80&w=2500&auto=format&fit=crop" 
      alt="Cinematic Japanese Countryside"
      class="w-full h-full object-cover"
      style="filter: saturate(1.1) contrast(1.05) brightness(0.8);"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0b10] via-[#0a0b10]/40 to-black/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-transparent to-transparent"></div>
    <div class="absolute inset-0 bg-[#5B1F2A] mix-blend-overlay opacity-20"></div>
  </div>

  <canvas id="petal-canvas" class="absolute inset-0 z-10 pointer-events-none"></canvas>

  <div class="relative z-20 container-ember h-full flex flex-col md:flex-row items-center justify-between pt-20">
    
    <div class="max-w-xl text-[#FBF6EE] drop-shadow-2xl">
      <p class="text-sm uppercase tracking-[0.3em] text-[#E8D9A8] font-semibold mb-6 opacity-0 translate-y-8" id="hero-subtitle">
        An immersive literary experience
      </p>
      <h1 class="font-display text-6xl md:text-8xl leading-[1.05] opacity-0 translate-y-8" id="hero-title">
        Where stories <br/>
        <span class="italic text-[#ffb7c5] drop-shadow-[0_0_15px_rgba(255,183,197,0.5)]">bloom.</span>
      </h1>
      <p class="mt-6 text-lg text-[#FBF6EE]/80 font-medium max-w-md opacity-0 translate-y-8" id="hero-desc">
        Step into our Japanese countryside library. Honest reviews for self-help and fantasy romance readers.
      </p>
      <div class="mt-10 flex gap-4 opacity-0 translate-y-8" id="hero-buttons">
        <a href="/blog/" class="rounded-full bg-[#FBF6EE] text-[#2b1b12] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(0,0,0,0.5)] hover:bg-white hover:-translate-y-1 transition-all duration-300">
          Explore the Library
        </a>
        <a href="/categories/" class="rounded-full bg-[#5B1F2A]/60 backdrop-blur-md border border-[#C9A227]/50 text-[#FBF6EE] px-8 py-4 font-semibold hover:bg-[#5B1F2A] hover:-translate-y-1 transition-all duration-300">
          Discover Books
        </a>
      </div>
    </div>

    <div class="relative w-[400px] h-[600px] opacity-0 scale-90" id="book-container">
      <canvas id="webgl-book" class="w-full h-full drop-shadow-[0_30px_50px_rgba(0,0,0,0.8)]"></canvas>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
    
    tl.to('#hero-subtitle', { opacity: 1, y: 0, duration: 1.2, delay: 0.5 })
      .to('#hero-title', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-desc', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-buttons', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#book-container', { opacity: 1, scale: 1, duration: 1.5 }, '-=1.2');

    const bg = document.getElementById('bg-parallax');
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;
      gsap.to(bg, { x: x * -30, y: y * -30, duration: 1.5, ease: 'power2.out', overwrite: 'auto' });
    });

    const container = document.getElementById('book-container');
    const canvas = document.getElementById('webgl-book');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
    
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.shadowMap.enabled = true;

    const coverCanvas = document.createElement('canvas');
    coverCanvas.width = 512;
    coverCanvas.height = 768;
    const coverCtx = coverCanvas.getContext('2d');
    
    coverCtx.fillStyle = '#5B1F2A';
    coverCtx.fillRect(0, 0, 512, 768);
    coverCtx.strokeStyle = '#C9A227';
    coverCtx.lineWidth = 3;
    coverCtx.strokeRect(30, 30, 452, 708);
    coverCtx.fillStyle = '#FBF6EE';
    coverCtx.font = 'bold 65px Georgia, serif';
    coverCtx.textAlign = 'center';
    coverCtx.fillText('EMBER', 256, 280);
    coverCtx.fillText('& INK', 256, 360);
    coverCtx.fillStyle = '#E8D9A8';
    coverCtx.font = 'italic 28px Georgia, serif';
    coverCtx.fillText('A Literary Dreamscape', 256, 460);
    
    const coverTexture = new THREE.CanvasTexture(coverCanvas);
    
    const pagesCanvas = document.createElement('canvas');
    pagesCanvas.width = 256;
    pagesCanvas.height = 256;
    const pagesCtx = pagesCanvas.getContext('2d');
    pagesCtx.fillStyle = '#FBF6EE';
    pagesCtx.fillRect(0, 0, 256, 256);
    pagesCtx.strokeStyle = '#D3C4B2';
    pagesCtx.lineWidth = 1;
    for(let i=0; i<256; i+=4) {
      pagesCtx.beginPath();
      pagesCtx.moveTo(0, i);
      pagesCtx.lineTo(256, i);
      pagesCtx.stroke();
    }
    const pagesTexture = new THREE.CanvasTexture(pagesCanvas);

    const coverMat = new THREE.MeshStandardMaterial({ map: coverTexture, roughness: 0.4, metalness: 0.1 });
    const backMat = new THREE.MeshStandardMaterial({ color: '#451722', roughness: 0.7 });
    const spineMat = new THREE.MeshStandardMaterial({ color: '#3d121b', roughness: 0.6 });
    const pagesMat = new THREE.MeshStandardMaterial({ map: pagesTexture, roughness: 0.9 });

    const bookGeo = new THREE.BoxGeometry(3.5, 5.25, 0.6);
    const materials = [ pagesMat, spineMat, pagesMat, pagesMat, coverMat, backMat ];
    
    const book = new THREE.Mesh(bookGeo, materials);
    scene.add(book);

    const ambient = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambient);
    const keyLight = new THREE.DirectionalLight(0xffedd5, 2.5);
    keyLight.position.set(5, 5, 5);
    scene.add(keyLight);
    const rimLight = new THREE.DirectionalLight(0x8ab4f8, 1.5);
    rimLight.position.set(-5, 0, -5);
    scene.add(rimLight);
    const pointLight = new THREE.PointLight(0xfbd38d, 2, 10);
    pointLight.position.set(0, -2, 3);
    scene.add(pointLight);

    camera.position.z = 8.5;

    let targetRotX = 0;
    let targetRotY = 0;

    document.addEventListener('mousemove', (e) => {
      const mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      const mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
      targetRotY = mouseX * 0.5;
      targetRotX = mouseY * 0.5;
    });

    const clock = new THREE.Clock();
    
    function animateBook() {
      requestAnimationFrame(animateBook);
      const time = clock.getElapsedTime();

      book.position.y = Math.sin(time * 1.5) * 0.15;
      book.rotation.y += (targetRotY - book.rotation.y) * 0.05;
      book.rotation.x += (targetRotX - book.rotation.x) * 0.05;
      book.rotation.y += 0.002;

      renderer.render(scene, camera);
    }
    animateBook();

    window.addEventListener('resize', () => {
      const width = container.clientWidth;
      const height = container.clientHeight;
      renderer.setSize(width, height);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    });

    const petalCanvas = document.getElementById('petal-canvas');
    const petalCtx = petalCanvas.getContext('2d');
    let width, height;

    function resize() {
      width = petalCanvas.width = window.innerWidth;
      height = petalCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const petals = [];
    for (let i = 0; i < 40; i++) {
      petals.push({
        x: Math.random() * width,
        y: Math.random() * -height,
        size: Math.random() * 8 + 4,
        speedY: Math.random() * 1.5 + 0.5,
        speedX: Math.random() * 1 - 0.5,
        rotation: Math.random() * 360,
        rotSpeed: Math.random() * 2 - 1,
        opacity: Math.random() * 0.5 + 0.2,
        swing: Math.random() * 2,
        swingSpeed: Math.random() * 0.02
      });
    }

    function drawPetals() {
      petalCtx.clearRect(0, 0, width, height);
      petals.forEach(p => {
        p.y += p.speedY;
        p.swing += p.swingSpeed;
        p.x += p.speedX + Math.sin(p.swing) * 1;
        p.rotation += p.rotSpeed;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }

        petalCtx.save();
        petalCtx.translate(p.x, p.y);
        petalCtx.rotate(p.rotation * Math.PI / 180);
        petalCtx.beginPath();
        petalCtx.ellipse(0, 0, p.size, p.size / 2, 0, 0, Math.PI * 2);
        petalCtx.fillStyle = `rgba(255, 183, 197, ${p.opacity})`;
        petalCtx.fill();
        petalCtx.restore();
      });
      requestAnimationFrame(drawPetals);
    }
    drawPetals();
  });
</script>
