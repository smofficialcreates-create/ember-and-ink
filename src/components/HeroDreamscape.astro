---
// Ember & Ink — Cinematic Parallax Hero
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#1a1c23]">
  
  <!-- 1. The Background Layer (Will scale on scroll) -->
  <div id="hero-bg" class="absolute inset-0 z-0 w-full h-full will-change-transform">
    <!-- Using a high-res anime image as fallback until you generate your video -->
    <img 
      src="https://images.unsplash.com/photo-1522383225653-ed111181a951?q=80&w=2500&auto=format&fit=crop" 
      alt="Japanese Countryside"
      class="w-full h-full object-cover"
    />
    <!-- Color Grading Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/20 to-transparent"></div>
    <div class="absolute inset-0 bg-[#5B1F2A] mix-blend-overlay opacity-20"></div>
  </div>

  <!-- 2. Custom Header Overlay -->
  <header class="absolute top-0 w-full z-30 px-6 md:px-12 py-6 flex justify-between items-center text-white">
    <a href="/" class="flex items-center gap-2 hover:text-gray-200 transition-colors drop-shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
      </svg>
      <span class="font-display text-xl tracking-wide font-medium">Ember &amp; Ink</span>
    </a>
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide drop-shadow-md">
      <a href="/categories/self-help/" class="hover:text-[#ffb7c5] transition-colors">Self-Help</a>
      <a href="/categories/fantasy-romance/" class="hover:text-[#ffb7c5] transition-colors">Fantasy Romance</a>
      <a href="/reviews/" class="hover:text-[#ffb7c5] transition-colors">Reviews</a>
      <a href="/blog/" class="hover:text-[#ffb7c5] transition-colors">Blog</a>
      <a href="/about/" class="hover:text-[#ffb7c5] transition-colors">About</a>
    </nav>
  </header>

  <!-- 3. Text Content (Will move faster on scroll) -->
  <div id="hero-content" class="relative z-20 container-ember h-full flex flex-col justify-center">
    <div class="max-w-2xl text-white pl-2 md:pl-8">
      <h1 class="font-display text-6xl md:text-8xl leading-[1.1] drop-shadow-xl" id="hero-title">
        Where stories <br/>
        <span class="italic text-[#ffb7c5]">bloom</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-white/95 font-medium max-w-lg drop-shadow-lg leading-relaxed">
        Step into our Japanese countryside library.<br/>
        Honest reviews for self-help and fantasy romance readers.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/blog/" class="group flex items-center gap-2 rounded-full bg-[#fbf6ee] text-[#2b1b12] px-8 py-3.5 font-semibold shadow-lg hover:bg-white hover:scale-105 transition-all duration-300">
          Explore the Library
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a href="/categories/" class="rounded-full bg-transparent border border-white/60 text-white px-8 py-3.5 font-semibold hover:bg-white/10 hover:border-white hover:scale-105 transition-all duration-300 backdrop-blur-sm">
          Discover Books
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register the plugin
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Entrance Animation
    gsap.from(['#hero-title', 'p', '.mt-10'], {
      y: 30, opacity: 0, duration: 1.2, stagger: 0.2, ease: 'power3.out', delay: 0.2
    });

    // 2. Scroll Parallax
    // As we scroll down, the background zooms in slightly and the text fades up and out
    gsap.to('#hero-bg', {
      yPercent: 20,
      scale: 1.1,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true
      }
    });

    gsap.to('#hero-content', {
      yPercent: -50,
      opacity: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'center top',
        scrub: true
      }
    });
  });
</script>
