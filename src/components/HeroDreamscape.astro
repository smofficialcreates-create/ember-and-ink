---
// Ember & Ink — Cinematic Japanese Dreamscape Hero
---

<section id="hero" class="relative w-full h-screen overflow-hidden bg-[#1a1c23]">
  <!-- 1. Cinematic Parallax Landscape (SVG) -->
  <div class="absolute inset-0 z-0 pointer-events-none" id="parallax-scene">
    
    <!-- Sky & Sun -->
    <svg class="absolute inset-0 w-full h-full object-cover" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" layer-speed="0.05">
      <defs>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2b344a"/>
          <stop offset="40%" stop-color="#5e6e7e"/>
          <stop offset="70%" stop-color="#d49a89"/>
          <stop offset="100%" stop-color="#f3cbb5"/>
        </linearGradient>
        <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffedd5" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#ffedd5" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="1440" height="900" fill="url(#skyGrad)"/>
      <circle cx="1100" cy="450" r="250" fill="url(#sunGlow)" filter="blur(20px)"/>
    </svg>

    <!-- Distant Misty Mountains -->
    <svg class="absolute bottom-0 w-full h-[60vh]" viewBox="0 0 1440 600" preserveAspectRatio="none" layer-speed="0.1">
      <path d="M0,400 Q150,200 350,350 T700,300 T1100,400 T1440,250 L1440,600 L0,600 Z" fill="#3a4b54" opacity="0.6" filter="blur(4px)"/>
      <path d="M0,500 Q250,300 500,450 T900,400 T1440,500 L1440,600 L0,600 Z" fill="#2d3b42" opacity="0.8" filter="blur(2px)"/>
    </svg>

    <!-- Midground Hills, River, and Train -->
    <svg class="absolute bottom-0 w-full h-[50vh]" viewBox="0 0 1440 500" preserveAspectRatio="none" layer-speed="0.3">
      <defs>
        <linearGradient id="riverGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7b9cae"/>
          <stop offset="100%" stop-color="#2b404c"/>
        </linearGradient>
        <linearGradient id="hillGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#4e6b50"/>
          <stop offset="100%" stop-color="#1e331f"/>
        </linearGradient>
      </defs>
      
      <!-- Train Tracks -->
      <path d="M0,300 L1440,320" stroke="#1a1c23" stroke-width="4" stroke-dasharray="10 5"/>
      
      <!-- Animated Train -->
      <g id="moving-train">
        <rect x="0" y="270" width="80" height="25" fill="#3d3f4a" rx="4"/>
        <rect x="5" y="275" width="15" height="10" fill="#f3cbb5" opacity="0.6"/>
        <rect x="25" y="275" width="15" height="10" fill="#f3cbb5" opacity="0.6"/>
        <rect x="45" y="275" width="15" height="10" fill="#f3cbb5" opacity="0.6"/>
        <rect x="65" y="275" width="10" height="10" fill="#f3cbb5" opacity="0.6"/>
      </g>

      <!-- River -->
      <path id="river" d="M600,300 Q700,400 650,500 L850,500 Q800,400 900,300 Z" fill="url(#riverGrad)"/>
      
      <!-- Wooden Bridge -->
      <path d="M680,380 Q750,360 820,380 L820,390 Q750,370 680,390 Z" fill="#4a2e1b"/>
      <path d="M690,380 L690,360" stroke="#4a2e1b" stroke-width="4"/>
      <path d="M810,380 L810,360" stroke="#4a2e1b" stroke-width="4"/>

      <!-- Midground Hills -->
      <path d="M0,450 Q200,350 500,450 T1000,380 T1440,450 L1440,500 L0,500 Z" fill="url(#hillGrad)"/>
    </svg>

    <!-- Foreground Hill and Cherry Blossom Tree -->
    <svg class="absolute bottom-0 w-full h-[45vh]" viewBox="0 0 1440 450" preserveAspectRatio="none" layer-speed="0.6">
      <defs>
        <linearGradient id="fgGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2b4230"/>
          <stop offset="100%" stop-color="#0f1a12"/>
        </linearGradient>
        <radialGradient id="blossomGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ffb7c5"/>
          <stop offset="100%" stop-color="#d48b9e" stop-opacity="0"/>
        </radialGradient>
      </defs>
      
      <!-- Foreground Grass -->
      <path d="M0,350 Q200,300 400,350 T800,300 T1440,350 L1440,450 L0,450 Z" fill="url(#fgGrad)"/>

      <!-- Tree Trunk & Branches -->
      <path d="M150,450 Q200,250 250,150 Q270,120 300,100 Q260,180 250,450 Z" fill="#1a100c"/>
      <path d="M250,200 Q350,150 450,180" stroke="#1a100c" stroke-width="8" fill="none"/>
      <path d="M230,280 Q150,220 100,250" stroke="#1a100c" stroke-width="6" fill="none"/>

      <!-- Cherry Blossom Clusters -->
      <g filter="blur(2px)">
        <circle cx="450" cy="180" r="80" fill="url(#blossomGlow)"/>
        <circle cx="100" cy="250" r="60" fill="url(#blossomGlow)"/>
        <circle cx="300" cy="100" r="90" fill="url(#blossomGlow)"/>
      </g>
      <g fill="#ffb7c5" opacity="0.8">
        <circle cx="430" cy="160" r="20"/>
        <circle cx="480" cy="200" r="25"/>
        <circle cx="120" cy="230" r="15"/>
        <circle cx="80" cy="270" r="20"/>
        <circle cx="280" cy="80" r="22"/>
        <circle cx="330" cy="120" r="18"/>
      </g>

      <!-- Cozy Reading Corner (Chair, Table, Book, Lantern) -->
      <g transform="translate(700, 320)">
        <!-- Wooden Chair -->
        <rect x="0" y="40" width="80" height="10" fill="#3b2212" rx="2"/>
        <rect x="0" y="0" width="10" height="40" fill="#3b2212"/>
        <rect x="70" y="0" width="10" height="40" fill="#3b2212"/>
        <rect x="0" y="0" width="80" height="10" fill="#3b2212" rx="2"/>
        
        <!-- Table -->
        <rect x="100" y="30" width="60" height="5" fill="#3b2212"/>
        <rect x="110" y="35" width="5" height="30" fill="#3b2212"/>
        <rect x="145" y="35" width="5" height="30" fill="#3b2212"/>
        
        <!-- Open Book on Table -->
        <path d="M110,25 L130,20 L150,25 L130,30 Z" fill="#FBF6EE"/>
        
        <!-- Antique Lantern -->
        <rect x="180" y="10" width="20" height="30" fill="#2b1b12"/>
        <rect x="185" y="15" width="10" height="20" fill="#fbd38d"/>
        <circle cx="190" cy="25" r="40" fill="#fbd38d" opacity="0.2" filter="blur(10px)"/>
        <rect x="175" y="40" width="30" height="5" fill="#2b1b12"/>
      </g>
    </svg>
  </div>

  <!-- 2. Canvas for Falling Petals -->
  <canvas id="petal-canvas" class="absolute inset-0 z-10 pointer-events-none"></canvas>

  <!-- 3. Content & 3D Book -->
  <div class="relative z-20 container-ember h-full flex flex-col md:flex-row items-center justify-between pt-20">
    <!-- Text -->
    <div class="max-w-xl text-[#FBF6EE] drop-shadow-md">
      <p class="text-sm uppercase tracking-[0.3em] text-[#fbd38d] font-semibold mb-6 opacity-0 translate-y-4" id="hero-subtitle">
        An immersive literary experience
      </p>
      <h1 class="font-display text-5xl md:text-7xl leading-[1.1] opacity-0 translate-y-4" id="hero-title">
        Where stories <br/>
        <span class="italic text-[#ffb7c5]">bloom.</span>
      </h1>
      <p class="mt-6 text-lg text-[#FBF6EE]/80 font-medium max-w-md opacity-0 translate-y-4" id="hero-desc">
        Step into our Japanese countryside library. Honest reviews for self-help and fantasy romance readers.
      </p>
      <div class="mt-10 flex gap-4 opacity-0 translate-y-4" id="hero-buttons">
        <a href="/blog/" class="rounded-full bg-[#FBF6EE] text-[#2b1b12] px-8 py-4 font-semibold shadow-[0_10px_20px_rgba(0,0,0,0.4)] hover:bg-white hover:-translate-y-1 transition-all duration-300">
          Explore the Library
        </a>
        <a href="/categories/" class="rounded-full bg-[#5B1F2A]/80 backdrop-blur-sm border border-[#C9A227]/50 text-[#FBF6EE] px-8 py-4 font-semibold hover:bg-[#5B1F2A] hover:-translate-y-1 transition-all duration-300">
          Discover Books
        </a>
      </div>
    </div>

    <!-- Three.js 3D Book Container -->
    <div class="relative w-[400px] h-[550px] opacity-0" id="book-container">
      <canvas id="webgl-book"></canvas>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import * as THREE from 'three';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Cinematic Entrance Animation
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
    
    tl.to('#hero-subtitle', { opacity: 1, y: 0, duration: 1.2, delay: 0.2 })
      .to('#hero-title', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-desc', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#hero-buttons', { opacity: 1, y: 0, duration: 1.2 }, '-=0.9')
      .to('#book-container', { opacity: 1, duration: 2 }, '-=1.2');

    // 2. Mouse Parallax for Landscape
    const layers = document.querySelectorAll('[layer-speed]');
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;
      layers.forEach(layer => {
        const speed = parseFloat(layer.getAttribute('layer-speed'));
        gsap.to(layer, { x: x * speed * 40, y: y * speed * 20, duration: 1.5, ease: 'power2.out' });
      });
    });

    // 3. Animate Train (Continuous)
    gsap.fromTo('#moving-train', 
      { x: -150 }, 
      { x: 1600, duration: 12, repeat: -1, ease: 'none', delay: 2 }
    );

    // 4. Three.js 3D Book Setup
    const canvas = document.getElementById('webgl-book');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 400 / 550, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(400, 550);
    renderer.setPixelRatio(window.devicePixelRatio);

    // Book Cover Texture (Generated via Canvas)
    const coverCanvas = document.createElement('canvas');
    coverCanvas.width = 512;
    coverCanvas.height = 768;
    const ctx = coverCanvas.getContext('2d');
    ctx.fillStyle = '#5B1F2A';
    ctx.fillRect(0, 0, 512, 768);
    ctx.strokeStyle = '#C9A227';
    ctx.lineWidth = 4;
    ctx.strokeRect(20, 20, 472, 728);
    ctx.fillStyle = '#FBF6EE';
    ctx.font = 'bold 55px Georgia';
    ctx.textAlign = 'center';
    ctx.fillText('EMBER', 256, 300);
    ctx.fillText('& INK', 256, 370);
    ctx.fillStyle = '#ffb7c5';
    ctx.font = 'italic 28px Georgia';
    ctx.fillText('A Literary Dreamscape', 256, 480);
    
    const coverTexture = new THREE.CanvasTexture(coverCanvas);

    // Book Geometry & Materials
    const bookGeo = new THREE.BoxGeometry(3, 4.5, 0.4);
    const coverMat = new THREE.MeshStandardMaterial({ map: coverTexture, roughness: 0.5, metalness: 0.1 });
    const sideMat = new THREE.MeshStandardMaterial({ color: '#451722', roughness: 0.8 });
    const pagesMat = new THREE.MeshStandardMaterial({ color: '#FBF6EE', roughness: 1 });

    const materials = [sideMat, sideMat, sideMat, sideMat, coverMat, pagesMat];
    const book = new THREE.Mesh(bookGeo, materials);
    scene.add(book);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffedd5, 2);
    dirLight.position.set(5, 5, 5);
    scene.add(dirLight);

    const pointLight = new THREE.PointLight(0xfbd38d, 1.5, 10);
    pointLight.position.set(-2, 2, 3);
    scene.add(pointLight);

    camera.position.z = 7;

    // Floating Animation & Tilt Interaction
    let mouseX = 0;
    let mouseY = 0;
    let targetRotationX = 0;
    let targetRotationY = 0;

    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
      targetRotationY = mouseX * 0.5;
      targetRotationX = mouseY * 0.5;
    });

    let time = 0;
    function animate() {
      requestAnimationFrame(animate);
      time += 0.01;

      // Smooth floating
      book.position.y = Math.sin(time) * 0.15;
      
      // Smooth mouse tilt (lerp)
      book.rotation.y += (targetRotationY - book.rotation.y) * 0.05;
      book.rotation.x += (targetRotationX - book.rotation.x) * 0.05;
      
      // Base rotation
      book.rotation.y += 0.002;

      renderer.render(scene, camera);
    }
    animate();

    // 5. Canvas Petal System
    const petalCanvas = document.getElementById('petal-canvas');
    const pCtx = petalCanvas.getContext('2d');
    let width, height;

    function resize() {
      width = petalCanvas.width = window.innerWidth;
      height = petalCanvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    const petals = [];
    for (let i = 0; i < 50; i++) {
      petals.push({
        x: Math.random() * width,
        y: Math.random() * -height,
        size: Math.random() * 6 + 4,
        speedY: Math.random() * 1.5 + 0.5,
        speedX: Math.random() * 1 - 0.5,
        rotation: Math.random() * 360,
        rotSpeed: Math.random() * 2 - 1,
        opacity: Math.random() * 0.6 + 0.2,
        swing: Math.random() * 2,
        swingSpeed: Math.random() * 0.02
      });
    }

    function drawPetals() {
      pCtx.clearRect(0, 0, width, height);
      petals.forEach(p => {
        p.y += p.speedY;
        p.swing += p.swingSpeed;
        p.x += p.speedX + Math.sin(p.swing) * 1;
        p.rotation += p.rotSpeed;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }

        pCtx.save();
        pCtx.translate(p.x, p.y);
        pCtx.rotate(p.rotation * Math.PI / 180);
        pCtx.beginPath();
        pCtx.ellipse(0, 0, p.size, p.size / 2, 0, 0, Math.PI * 2);
        pCtx.fillStyle = `rgba(255, 183, 197, ${p.opacity})`;
        pCtx.fill();
        pCtx.restore();
      });
      requestAnimationFrame(drawPetals);
    }
    drawPetals();
  });
</script>
