---
/**
 * Sticky header.
 * Highlights the two flagship shelves (Self-Help, Fantasy Romance) via
 * `highlight: true` in NAV. Mobile menu uses a native <details> element
 * so it works with zero JavaScript and full keyboard accessibility.
 */
import { NAV } from '@lib/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-line">
  <div class="container-ember flex items-center justify-between gap-4 h-16 md:h-20">
    {/* Logo */}
    <a
      href="/"
      class="flex items-center gap-2 font-display text-xl md:text-2xl font-semibold text-burgundy hover:text-burgundy-dark transition-colors shrink-0"
    >
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-burgundy text-gold">
        <svg viewBox="0 0 64 64" class="h-5 w-5" aria-hidden="true">
          <path
            d="M32 12c5 9 12 13 12 22a12 12 0 0 1-24 0c0-6 3-10 6-14 1 4 3 6 6 8-1-6 0-11 0-16Z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span>Ember <span class="text-gold">&amp;</span> Ink</span>
    </a>

    {/* Desktop navigation */}
    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-pill px-3 py-2 text-sm font-medium transition-colors',
            item.highlight
              ? isActive(item.href)
                ? 'bg-burgundy text-paper'
                : 'bg-gold-soft/70 text-burgundy hover:bg-gold-soft'
              : isActive(item.href)
                ? 'text-burgundy'
                : 'text-ink/80 hover:text-burgundy',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* Mobile navigation (no JS required) */}
    <details class="lg:hidden relative">
      <summary
        class="list-none cursor-pointer rounded-pill border border-line px-4 py-2 text-sm font-medium text-burgundy hover:border-gold transition-colors"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 mt-2 w-56 rounded-card bg-paper border border-line shadow-lift p-2"
        aria-label="Mobile"
      >
        {NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              item.highlight
                ? 'text-burgundy bg-gold-soft/60'
                : 'text-ink hover:bg-cream',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>