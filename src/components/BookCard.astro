---
/**
 * BookCard.astro
 * Premium physical bookstore & luxury editorial book card.
 * Respects true vertical book-cover proportions (2:3 aspect ratio).
 * Includes 3D spine depth, tactile pedestal shadow, and Amazon quick buy action.
 */
import type { BlogPost } from '@lib/posts';
import { getBookEditorialMeta } from '@lib/book-meta';
import { withAmazonTag } from '@lib/amazon';

interface Props {
  post: BlogPost;
  eager?: boolean;
  layout?: 'vertical' | 'horizontal';
}

const { post, eager = false, layout = 'vertical' } = Astro.props;
const meta = getBookEditorialMeta(post);
const reviewUrl = `/blog/${post.id}/`;
const amazonUrl = withAmazonTag(post.data.amazonLink);
---

{layout === 'vertical' ? (
  <article
    class="book-card-editorial group relative flex flex-col h-full rounded-2xl bg-paper border border-line/80 shadow-[0_4px_20px_-4px_rgba(42,33,24,0.08)] transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_20px_40px_-12px_rgba(42,33,24,0.18)] hover:border-gold/50 overflow-hidden"
    data-book-card
    data-genre-id={meta.curatedShelf.id}
    data-category={meta.genre}
    data-title={meta.bookTitle.toLowerCase()}
    data-author={meta.author.toLowerCase()}
    data-rating={meta.rating ?? 0}
    data-featured={meta.isFeatured ? 'true' : 'false'}
    data-pub-time={post.data.pubDate.valueOf()}
  >
    {/* Book Cover Presentation Shelf (Physical 2:3 Aspect Ratio) */}
    <div class="relative bg-gradient-to-b from-cream via-[#f5ede0] to-cream/80 p-6 pb-5 flex items-center justify-center overflow-hidden border-b border-line/60">
      <div class="pointer-events-none absolute inset-0 opacity-40 bg-[radial-gradient(#c9a14a_0.75px,transparent_0.75px)] [background-size:12px_12px]"></div>

      {/* 3D Physical Book Silhouette */}
      <div class="relative z-10 w-36 sm:w-40 md:w-44 aspect-[2/3] transition-transform duration-500 ease-out group-hover:scale-[1.03] group-hover:-rotate-1">
        <div class="absolute -bottom-3 inset-x-2 h-4 bg-black/25 blur-md rounded-full transition-all duration-500 group-hover:scale-105 group-hover:blur-lg"></div>

        <div class="relative h-full w-full rounded-r-md rounded-l-[2px] overflow-hidden shadow-[4px_12px_24px_-4px_rgba(42,33,24,0.35)] border border-black/10 bg-[#1e171b]">
          <img
            src={meta.coverImage}
            alt={meta.coverAlt}
            class="h-full w-full object-cover object-center"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            width="280"
            height="420"
          />

          <div class="pointer-events-none absolute inset-y-0 left-0 w-3.5 bg-gradient-to-r from-black/40 via-white/20 to-transparent"></div>
          <div class="pointer-events-none absolute inset-y-0 right-0 w-[2px] bg-gradient-to-b from-amber-100/60 via-amber-50/40 to-amber-100/60"></div>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        </div>

        {meta.isFeatured && (
          <span class="absolute -top-2 -right-2 z-20 rounded-full bg-burgundy text-[#fffaf0] border border-gold-soft/60 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider shadow-md">
            Staff Pick
          </span>
        )}
      </div>
    </div>

    {/* Book Editorial Content */}
    <div class="p-6 flex flex-col flex-1 justify-between gap-4">
      <div class="space-y-2.5">
        <div class="flex items-center justify-between gap-2 text-xs">
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-medium tracking-wide border border-current/20',
              meta.curatedShelf.badgeBg,
              meta.curatedShelf.badgeText,
            ]}
          >
            <span class="text-[11px]" aria-hidden="true">{meta.curatedShelf.motif}</span>
            <span>{meta.curatedShelf.shortName}</span>
          </span>

          {meta.ratingStars ? (
            <div class="flex items-center gap-1 font-mono text-xs text-[#c9a14a]" title={`Rated ${meta.rating} out of 5 stars`}>
              <span class="tracking-widest">{meta.ratingStars}</span>
            </div>
          ) : (
            <span class="text-[11px] font-mono uppercase tracking-wider text-muted/70">
              {meta.readTime}
            </span>
          )}
        </div>

        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold text-muted">
          {meta.author}
        </p>

        <h3 class="font-display text-xl leading-snug font-semibold text-burgundy group-hover:text-burgundy-dark transition-colors">
          <a href={reviewUrl} class="focus:outline-none after:absolute after:inset-0 after:content-['']">
            {meta.bookTitle}
          </a>
        </h3>

        <p class="text-xs sm:text-sm text-ink/75 line-clamp-2 leading-relaxed font-light">
          {meta.excerpt}
        </p>
      </div>

      <div class="pt-4 border-t border-line/60 flex items-center justify-between gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 font-semibold text-burgundy group-hover:text-gold transition-colors">
          <span>Read Review</span>
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
        </span>

        {amazonUrl && (
          <a
            href={amazonUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="relative z-10 inline-flex items-center gap-1 rounded-full bg-burgundy/10 hover:bg-burgundy hover:text-[#fffdf7] text-burgundy px-3 py-1 font-bold text-[11px] uppercase tracking-wider transition-all shadow-2xs hover:scale-105 active:scale-95"
            title={`Check Price for ${meta.bookTitle} on Amazon`}
          >
            <span>Amazon</span>
            <span aria-hidden="true">&nearr;</span>
          </a>
        )}
      </div>
    </div>
  </article>
) : (
  <article
    class="book-card-editorial group relative flex flex-col sm:flex-row items-center gap-6 rounded-2xl bg-paper border border-line/80 p-5 shadow-[0_4px_20px_-4px_rgba(42,33,24,0.08)] transition-all duration-400 hover:-translate-y-1 hover:shadow-[0_16px_36px_-10px_rgba(42,33,24,0.16)] hover:border-gold/50"
    data-book-card
    data-genre-id={meta.curatedShelf.id}
    data-category={meta.genre}
    data-title={meta.bookTitle.toLowerCase()}
    data-author={meta.author.toLowerCase()}
    data-rating={meta.rating ?? 0}
    data-featured={meta.isFeatured ? 'true' : 'false'}
    data-pub-time={post.data.pubDate.valueOf()}
  >
    <div class="relative w-28 sm:w-32 aspect-[2/3] shrink-0">
      <div class="absolute -bottom-2 inset-x-1.5 h-3 bg-black/20 blur-sm rounded-full"></div>
      <div class="relative h-full w-full rounded-r rounded-l-[1px] overflow-hidden shadow-md border border-black/10 bg-[#1e171b]">
        <img
          src={meta.coverImage}
          alt={meta.coverAlt}
          class="h-full w-full object-cover"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
        <div class="pointer-events-none absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/40 via-white/20 to-transparent"></div>
      </div>
    </div>

    <div class="flex-1 min-w-0 flex flex-col justify-between py-1">
      <div>
        <div class="flex items-center gap-3 text-xs mb-2">
          <span class:list={['rounded-full px-2.5 py-0.5 font-medium border border-current/20', meta.curatedShelf.badgeBg, meta.curatedShelf.badgeText]}>
            {meta.curatedShelf.shortName}
          </span>
          <span class="text-muted text-[11px] font-mono">{meta.readTime}</span>
          {meta.ratingStars && (
            <span class="text-[#c9a14a] font-mono tracking-wider ml-auto">{meta.ratingStars}</span>
          )}
        </div>

        <p class="text-xs uppercase tracking-widest text-muted font-semibold mb-1">
          {meta.author}
        </p>

        <h3 class="font-display text-xl font-semibold text-burgundy group-hover:text-burgundy-dark transition-colors line-clamp-1">
          <a href={reviewUrl} class="focus:outline-none after:absolute after:inset-0 after:content-['']">
            {meta.bookTitle}
          </a>
        </h3>

        <p class="mt-2 text-xs sm:text-sm text-ink/75 line-clamp-2 leading-relaxed font-light">
          {meta.excerpt}
        </p>
      </div>

      <div class="mt-4 pt-3 border-t border-line/60 flex items-center justify-between gap-2 text-xs">
        <span class="inline-flex items-center gap-1 font-semibold text-burgundy group-hover:text-gold transition-colors">
          <span>Read Review</span>
          <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
        </span>

        {amazonUrl && (
          <a
            href={amazonUrl}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="relative z-10 inline-flex items-center gap-1 rounded-full bg-burgundy/10 hover:bg-burgundy hover:text-[#fffdf7] text-burgundy px-3 py-1 font-bold text-[11px] uppercase tracking-wider transition-all shadow-2xs hover:scale-105 active:scale-95"
            title={`Check Price for ${meta.bookTitle} on Amazon`}
          >
            <span>Amazon</span>
            <span aria-hidden="true">&nearr;</span>
          </a>
        )}
      </div>
    </div>
  </article>
)}
