---
import type { BlogPost } from '@lib/posts';
import { formatDate } from '@lib/format';

interface Props {
  post: BlogPost;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const cover = post.data.coverImage;
const href = `/blog/${post.id}/`;
const pubIso = post.data.pubDate.toISOString();
---

<article class="group relative flex flex-col rounded-2xl bg-paper border border-line shadow-sm overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-gold/50">
  {cover ? (
    <div class="aspect-[16/10] overflow-hidden bg-cream">
      <img
        src={cover}
        alt={post.data.coverAlt ?? `Cover for ${post.data.title}`}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        width="800"
        height="500"
      />
    </div>
  ) : (
    <div class="aspect-[16/10] bg-gradient-to-br from-burgundy to-ink flex items-center justify-center">
      <span class="font-display text-3xl text-gold/80 select-none">Ember &amp; Ink</span>
    </div>
  )}

  <div class="p-6 flex flex-col flex-1 relative">
    <div class="flex items-center gap-3 text-xs text-muted mb-3 uppercase tracking-wider font-medium">
      <span class="rounded-full bg-gold-soft/40 text-burgundy px-3 py-1">
        {post.data.category}
      </span>
      <time datetime={pubIso}>{formatDate(post.data.pubDate)}</time>
    </div>

    <h3 class="font-display text-xl md:text-2xl leading-snug text-burgundy group-hover:text-burgundy-dark transition-colors">
      <a href={href} class="focus:outline-none after:absolute after:inset-0 after:content-['']">
        {post.data.title}
      </a>
    </h3>

    <p class="mt-3 text-sm text-muted/80 line-clamp-3 flex-1 leading-relaxed">
      {post.data.description}
    </p>
    
    <div class="mt-4 pt-4 border-t border-line/50 flex items-center text-xs font-semibold text-burgundy uppercase tracking-widest">
      Read Review <span class="ml-2 group-hover:translate-x-1 transition-transform">→</span>
    </div>
  </div>
</article>
