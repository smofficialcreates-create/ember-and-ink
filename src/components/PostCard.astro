---
/**
 * PostCard — soft card preview used on the home page, blog index,
 * category/tag pages, and related-posts sections.
 *
 * Uses a plain <img> because `coverImage` is a string path in
 * frontmatter; if the path is missing, a branded gradient fallback
 * is shown instead.
 */
import type { BlogPost } from '@lib/posts';
import { formatDate } from '@lib/format';

interface Props {
  post: BlogPost;
  /** Load the image eagerly (use for the first 1–3 above-the-fold cards). */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const cover = post.data.coverImage;
const href = `/blog/${post.id}/`;
const pubIso = post.data.pubDate.toISOString();
---

<article class="group relative flex flex-col rounded-card bg-paper border border-line shadow-soft overflow-hidden transition-transform duration-300 hover:-translate-y-1 hover:shadow-lift">
  {cover ? (
    <div class="aspect-[16/10] overflow-hidden bg-cream">
      <img
        src={cover}
        alt={post.data.coverAlt ?? `Cover for ${post.data.title}`}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        width="800"
        height="500"
      />
    </div>
  ) : (
    <div class="aspect-[16/10] bg-gradient-to-br from-burgundy to-ink flex items-center justify-center">
      <span class="font-display text-3xl text-gold/80 select-none">
        Ember &amp; Ink
      </span>
    </div>
  )}

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center gap-3 text-xs text-muted mb-2">
      <span class="rounded-pill bg-gold-soft/60 text-burgundy px-2.5 py-0.5 font-medium">
        {post.data.category}
      </span>
      <time datetime={pubIso}>{formatDate(post.data.pubDate)}</time>
    </div>

    <h3 class="font-display text-lg md:text-xl leading-snug text-burgundy group-hover:text-burgundy-dark">
      {/* The `after:` pseudo-element makes the whole card clickable without nesting interactive elements. */}
      <a href={href} class="focus:outline-none after:absolute after:inset-0 after:content-['']">
        {post.data.title}
      </a>
    </h3>

    <p class="mt-2 text-sm text-muted line-clamp-3 flex-1">
      {post.data.description}
    </p>
  </div>
</article>