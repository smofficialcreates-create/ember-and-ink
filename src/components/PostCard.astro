---
/**
 * PostCard.astro
 * Delegates to BookCard to guarantee true vertical book-cover proportions,
 * 3D spine depth, and editorial typography everywhere.
 */
import BookCard from './BookCard.astro';
import type { BlogPost } from '@lib/posts';

interface Props {
  post: BlogPost;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
---

<BookCard post={post} eager={eager} layout="vertical" />
