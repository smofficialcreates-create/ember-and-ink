---
import { Image } from 'astro:assets';
/**
 * SceneReviews.astro
 * Scene 05 â€” Open Book Reviews: Realistic two-page spread showing book
 * cover, editorial verdict, quote, and direct affiliate reading links.
 */
import type { BlogPost } from '@lib/posts';
import { withAmazonTag } from '@lib/amazon';
import { formatDate } from '@lib/format';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const reviewPosts = posts.slice(0, 3);
---

<section id="open-book-reviews" class="scene-section relative bg-[#f4ece1] py-28 md:py-40 border-b border-[#ded2bd]">
  <!-- Decorative Background Label -->
  <div class="pointer-events-none absolute left-8 top-12 select-none text-[8rem] md:text-[14rem] font-display font-bold leading-none text-[#5c1f2c]/[0.035]">
    05
  </div>

  <div class="container-ember relative z-10">
    <!-- Header -->
    <div class="max-w-2xl mb-12 md:mb-16">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-[#c9a14a]"></span>
        <p class="scene-eyebrow text-[#9a7444]">Scene 05 Â· The Open Tome</p>
      </div>
      <h2 class="scene-headline mt-3 text-3xl md:text-5xl text-[#5c1f2c]">
        Between the covers, <span class="italic text-[#9b3c4a]">truths unfold</span>.
      </h2>
      <p class="scene-subtext mt-4 text-[#6e6155]">
        Open to the reader's notebook. Turn the pages to inspect our in-depth notes, critical verdicts, and purchase links.
      </p>
    </div>

    <!-- Review selector tabs -->
    <div class="flex flex-wrap gap-2 mb-8">
      {reviewPosts.map((post, index) => (
        <button
          type="button"
          class:list={[
            'review-tab px-5 py-2.5 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 border',
            index === 0
              ? 'bg-[#5c1f2c] text-[#fffaf0] border-[#5c1f2c] shadow-md'
              : 'bg-[#fffdf7] text-[#6e6155] border-[#d8cdbb] hover:border-[#c9a14a] hover:text-[#5c1f2c]'
          ]}
          data-tab-index={index}
        >
          {post.data.title.split(':')[0].trim()}
        </button>
      ))}
    </div>

    <!-- The Physical Open Book Spread Container -->
    <div class="relative max-w-5xl mx-auto rounded-3xl bg-[#fffdf8] border border-[#d8ccb6] shadow-[0_30px_90px_rgba(43,33,24,0.14)] p-6 md:p-12 overflow-hidden">
      
      <!-- Spine shadow in center (simulating open spine crease) -->
      <div class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 w-16 hidden md:block bg-gradient-to-r from-transparent via-[#2b170e]/[0.09] to-transparent z-20"></div>
      
      <!-- Headband silk accent at top & bottom of crease -->
      <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-12 h-2 hidden md:block bg-gradient-to-r from-[#9b3c4a] via-[#c9a14a] to-[#9b3c4a] z-30 rounded-b-sm"></div>
      <div class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-12 h-2 hidden md:block bg-gradient-to-r from-[#9b3c4a] via-[#c9a14a] to-[#9b3c4a] z-30 rounded-t-sm"></div>

      <!-- Book Spread Content Panes -->
      {reviewPosts.map((post, index) => {
        const amazonUrl = withAmazonTag(post.data.amazonLink);
        return (
          <div
            class:list={[
              'review-pane grid md:grid-cols-2 gap-8 md:gap-16 transition-opacity duration-500',
              index === 0 ? 'block' : 'hidden'
            ]}
            data-pane-index={index}
          >
            <!-- Left Page: Cover, Metadata & Purchase -->
            <div class="flex flex-col justify-between border-b md:border-b-0 md:border-r border-[#ece3d3] pb-8 md:pb-0 md:pr-10">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-[#9a7444] mb-4">
                  <span>FOLIO NO. 0{index + 1}</span>
                  <span class="uppercase tracking-wider">{post.data.category}</span>
                </div>

                <!-- Cover Artwork -->
                <div class="relative aspect-[3/4] max-w-[280px] mx-auto rounded-xl overflow-hidden shadow-[0_16px_40px_rgba(43,33,24,0.16)] border border-[#e5d9c5]">
                  {post.data.coverImage ? (
                    <img
                      src={post.data.coverImage}
                      alt={`Cover of ${post.data.title}`}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-[#5c1f2c] to-[#2a2118] flex items-center justify-center p-6 text-center text-[#e8d5a3] font-display text-xl">
                      {post.data.title}
                    </div>
                  )}
                </div>

                <div class="mt-6 text-center">
                  <span class="inline-block px-3 py-1 rounded-full bg-[#f3ebd9] text-[#5c1f2c] text-xs font-semibold">
                    Verdict: Highly Recommended
                  </span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-8 flex flex-col sm:flex-row gap-3">
                {amazonUrl && (
                  <a
                    href={amazonUrl}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center gap-2 rounded-full bg-[#5c1f2c] text-[#fffaf0] py-3 px-5 text-xs font-semibold hover:bg-[#40141e] transition-colors shadow-sm"
                  >
                    Check Price on Amazon â†—
                  </a>
                )}
                <a
                  href={`/blog/${post.id}/`}
                  class="flex-1 inline-flex items-center justify-center gap-2 rounded-full border border-[#5c1f2c] text-[#5c1f2c] py-3 px-5 text-xs font-semibold hover:bg-[#5c1f2c]/5 transition-colors"
                >
                  Full Review â†’
                </a>
              </div>
            </div>

            <!-- Right Page: Editorial Review & Quote -->
            <div class="flex flex-col justify-between md:pl-4">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#9a7444] mb-2">
                  Editorial Examination Â· {formatDate(post.data.pubDate)}
                </p>

                <h3 class="font-display text-2xl md:text-3xl font-semibold text-[#5c1f2c] leading-tight mb-4">
                  {post.data.title}
                </h3>

                <!-- Decorative quote callout -->
                <blockquote class="my-6 pl-5 border-l-2 border-[#c9a14a] italic font-display text-lg text-[#2a2118] bg-[#fbf7ee] py-3 rounded-r-xl">
                  â€œ{post.data.description}â€
                </blockquote>

                <!-- Excerpt body -->
                <div class="text-[#2a2118]/85 text-sm md:text-base leading-relaxed space-y-3 font-serif">
                  <p>
                    Every reader knows the singular sensation of picking up a work that reframes their perspective. In our examination, this title distinguishes itself through crystalline prose and an uncompromising narrative velocity.
                  </p>
                  <p class="text-xs text-[#6e6155] italic">
                    Tags: {post.data.tags.slice(0, 4).map(t => `#${t}`).join(' ')}
                  </p>
                </div>
              </div>

              <!-- Page Footer Pagination -->
              <div class="mt-8 pt-4 border-t border-[#ece3d3] flex items-center justify-between text-xs text-[#6e6155] font-mono">
                <span>Ember & Ink Literary Review</span>
                <span>Page 0{index + 1} of 0{reviewPosts.length}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Tab switching logic for review book pages
  const tabs = document.querySelectorAll<HTMLButtonElement>('.review-tab');
  const panes = document.querySelectorAll<HTMLElement>('.review-pane');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = tab.dataset.tabIndex;
      if (idx === undefined) return;

      // Update tabs
      tabs.forEach((t) => {
        t.classList.remove('bg-[#5c1f2c]', 'text-[#fffaf0]', 'border-[#5c1f2c]', 'shadow-md');
        t.classList.add('bg-[#fffdf7]', 'text-[#6e6155]', 'border-[#d8cdbb]');
      });
      tab.classList.remove('bg-[#fffdf7]', 'text-[#6e6155]', 'border-[#d8cdbb]');
      tab.classList.add('bg-[#5c1f2c]', 'text-[#fffaf0]', 'border-[#5c1f2c]', 'shadow-md');

      // Update panes
      panes.forEach((p) => {
        if (p.dataset.paneIndex === idx) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });
    });
  });
</script>

