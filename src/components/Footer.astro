---
/**
 * Site-wide footer.
 *
 * Contains:
 *  • Brand blurb and Amazon Associates disclosure (required for program compliance)
 *  • Explore column (internal links to key shelves)
 *  • Legal column — including the "Cookie settings" button, which re-opens
 *    the consent banner via the `data-consent-open` attribute handled by
 *    `public/scripts/consent.js`.
 */
import { SITE } from '@lib/site';

const year = new Date().getFullYear();
---

<footer class="bg-burgundy-dark text-cream/90 mt-20">
  <div class="container-ember py-14">
    <div class="grid md:grid-cols-4 gap-10">
      {/* Brand + Amazon Associates disclosure */}
      <div class="md:col-span-2">
        <p class="font-display text-2xl text-cream">
          Ember <span class="text-gold">&amp;</span> Ink
        </p>
        <p class="mt-3 max-w-md text-sm text-cream/70">
          {SITE.tagline} Honest reviews, thoughtful essays, and curated
          reading lists for self-help and fantasy romance readers.
        </p>
        <p class="mt-6 text-xs text-cream/60 max-w-md">
          Ember &amp; Ink is a participant in the Amazon Services LLC
          Associates Program, an affiliate advertising program designed to
          provide a means for sites to earn advertising fees by advertising
          and linking to Amazon.com.
        </p>
      </div>

      {/* Explore */}
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-gold">
          Explore
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a class="hover:text-gold transition-colors" href="/blog/">
              All reviews
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/categories/">
              Categories
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/tags/">
              Tags
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/reviews/">
              Reviews
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/faq/">
              FAQ
            </a>
          </li>
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-gold">
          The legal bits
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a class="hover:text-gold transition-colors" href="/about/">
              About
            </a>
          </li>
          <li>
            <a
              class="hover:text-gold transition-colors"
              href="/affiliate-disclosure/"
            >
              Affiliate Disclosure
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/privacy/">
              Privacy Policy
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/terms/">
              Terms
            </a>
          </li>
          <li>
            <a class="hover:text-gold transition-colors" href="/contact/">
              Contact
            </a>
          </li>
          <li>
            {/* Re-opens the cookie consent banner (handled by consent.js) */}
            <button
              type="button"
              data-consent-open
              class="hover:text-gold transition-colors"
            >
              Cookie settings
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-cream/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-cream/60"
    >
      <p>© {year} Ember &amp; Ink. All rights reserved.</p>
      <p class="max-w-xl">
        As an Amazon Associate, we earn from qualifying purchases. Links
        marked with the Amazon logo support the site at no extra cost to you.
      </p>
    </div>
  </div>
</footer>