---
/**
 * SceneBooks.astro
 * Scene 02 — Tranquility: Sakura Train Sanctuary
 *
 * 100% Solid, Opaque Luxury Editorial Book Cards.
 * Guaranteed zero translucency / zero see-through under all conditions.
 * Physical gold/obsidian aesthetic with high-contrast typography and instant Amazon buy links.
 */
import type { BlogPost } from '@lib/posts';
import { formatDate } from '@lib/format';
import { getBookEditorialMeta } from '@lib/book-meta';
import { withAmazonTag } from '@lib/amazon';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const displayPosts = posts.slice(0, 3);
---

<section
  id="tranquility-shelf"
  class="scene-anime relative isolate min-h-[850px] py-16 md:py-24 lg:py-28 bg-black text-[#fbf6ee] overflow-hidden"
>
  <!-- ░░ HIGH-RES ANIME SAKURA TRAIN BACKGROUND ░░ -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      id="tranquility-bg"
      src="/images/scenes/sakura-train-tranquility.jpg"
      alt="Anime sakura cherry blossom hillside with steam train crossing stone bridge over river at sunrise"
      class="w-full h-full object-cover object-center scale-105"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Left vignette: pure black, no colour cast, for text legibility -->
  <div class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-r from-black/90 via-black/55 to-black/15"></div>
  <!-- Bottom fade to blend into next section -->
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-black/95 via-transparent to-black/40"></div>
  <!-- Subtle warm sun glow top-right — amber only, no green -->
  <div class="pointer-events-none absolute -top-24 -right-24 w-[60%] h-[60%] rounded-full blur-3xl bg-gradient-to-bl from-amber-300/15 via-amber-100/6 to-transparent z-[2] mix-blend-screen"></div>

  <!-- ░░ CINEMATIC ANIMATION CANVAS ░░ -->
  <canvas
    id="tranquility-canvas"
    class="pointer-events-none absolute inset-0 z-[4] w-full h-full"
    aria-hidden="true"
  ></canvas>

  <!-- ════════════════════════════════════════════════════
       EDITORIAL CONTENT
  ════════════════════════════════════════════════════ -->
  <div class="container-ember relative z-10">
    <div class="grid lg:grid-cols-[1fr_1.15fr] gap-10 lg:gap-14 items-center">

      <!-- Left: Typography & Narrative -->
      <div class="max-w-xl">
        <p class="text-xs uppercase tracking-[0.32em] text-[#e8d5a3] font-semibold mb-4 drop-shadow">
          02 / Experience
        </p>

        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight drop-shadow-lg">
          Tranquility
        </h2>

        <p class="mt-6 text-base md:text-lg text-white/90 font-light leading-relaxed drop-shadow">
          A cherry-blossom morning on the hillside above the valley. A steam train glides across the stone bridge, petals drift on the gentle breeze, and the river catches the first golden light. Away from algorithmic noise, reading becomes an act of quiet restoration.
        </p>

        <div class="mt-8">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-[#e8d5a3] hover:text-white transition-colors group"
          >
            <span>— Discover all featured books</span>
            <span class="group-hover:translate-x-1.5 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right: Three Latest Book Cards — 100% Solid Opaque Luxury Obsidian Cards -->
      <div class="space-y-4">
        {displayPosts.map((post, index) => {
          const meta = getBookEditorialMeta(post);
          const amazonUrl = withAmazonTag(post.data.amazonLink);
          return (
            <article
              class="tranquility-card group relative rounded-2xl md:rounded-3xl border border-[#c9a14a]/35 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#c9a14a]/70"
              style="background-color: #120e18 !important; background: #120e18 !important; opacity: 1 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important;"
            >
              <!-- Fine luxury gold hairline on top edge -->
              <div class="pointer-events-none absolute top-0 inset-x-8 h-[2px] bg-gradient-to-r from-transparent via-[#c9a14a]/60 to-transparent"></div>

              <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center">

                <!-- Book Cover (2:3 aspect ratio with 3D spine depth) -->
                <div class="relative w-20 h-28 sm:w-24 sm:h-36 rounded-xl overflow-hidden shadow-lg flex-shrink-0 bg-[#08060a] border border-[#c9a14a]/30">
                  {post.data.coverImage ? (
                    <img
                      src={post.data.coverImage}
                      alt={`Cover for ${meta.bookTitle}`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full bg-[#16121c] flex items-center justify-center p-2 text-center text-xs text-[#e8d5a3] font-display">
                      {meta.bookTitle}
                    </div>
                  )}
                  <div class="pointer-events-none absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/60 via-white/20 to-transparent"></div>
                </div>

                <!-- Content: Crisp, 100% High-Contrast Typography -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between text-xs mb-2 font-mono">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold uppercase tracking-wider text-[#e8d5a3] bg-[#c9a14a]/15 border border-[#c9a14a]/35">
                      {meta.curatedShelf.shortName}
                    </span>
                    <span class="font-bold text-[#e8d5a3]">0{index + 1} / 03</span>
                  </div>

                  <h3 class="font-display text-xl sm:text-2xl font-bold text-white group-hover:text-[#e8d5a3] transition-colors line-clamp-1">
                    <a href={`/blog/${post.id}/`} class="focus:outline-none after:absolute after:inset-0">
                      {meta.bookTitle}
                    </a>
                  </h3>

                  <p class="text-xs uppercase tracking-wider text-[#e8d5a3] font-medium mt-1">
                    By {meta.author}
                  </p>

                  <p class="mt-2 text-xs sm:text-sm text-[#f5efe6] line-clamp-2 font-normal leading-relaxed">
                    {post.data.description}
                  </p>

                  <div class="mt-3.5 flex items-center justify-between text-xs pt-3 border-t border-white/15">
                    <div class="flex items-center gap-2">
                      {meta.ratingStars && (
                        <span class="font-mono text-gold tracking-wider text-xs font-bold">{meta.ratingStars}</span>
                      )}
                      <time datetime={post.data.pubDate.toISOString()} class="text-[#d4c5b3] font-mono text-[11px]">
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>

                    <div class="flex items-center gap-3">
                      <span class="text-[#e8d5a3] font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                        Read review <span>→</span>
                      </span>

                      {amazonUrl && (
                        <a
                          href={amazonUrl}
                          target="_blank"
                          rel="sponsored nofollow noopener noreferrer"
                          class="relative z-10 inline-flex items-center gap-1.5 rounded-full bg-burgundy hover:bg-[#801b2f] text-[#fffdf7] px-3.5 py-1.5 font-bold text-[11px] uppercase tracking-wider border border-gold/40 shadow-md hover:scale-105 transition-all"
                          title={`Check Price for ${meta.bookTitle} on Amazon`}
                        >
                          <span>Amazon</span>
                          <span aria-hidden="true">&nearr;</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>

              </div>
            </article>
          );
        })}
      </div>

    </div>
  </div>
</section>

<style>
  .tranquility-card {
    background-color: #120e18 !important;
    background: #120e18 !important;
    opacity: 1 !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(201, 161, 74, 0.3) !important;
  }
  .tranquility-card:hover {
    background-color: #1a1424 !important;
    background: #1a1424 !important;
    box-shadow: 0 30px 70px -12px rgba(0, 0, 0, 0.98), 0 0 0 1px rgba(232, 213, 163, 0.55) !important;
  }
</style>

<script>
  import { mountTranquilityScene } from '../scripts/tranquility-scene.js';
  import gsap from 'gsap';

  // Mount cinematic animation canvas
  const canvas = document.getElementById('tranquility-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    mountTranquilityScene(canvas);
  }

  // 2.5D Mouse Parallax on background (desktop fine-pointer only)
  const bg      = document.getElementById('tranquility-bg');
  const section = document.getElementById('tranquility-shelf');

  if (
    bg && section &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const moveX = gsap.quickTo(bg, 'x', { duration: 0.9, ease: 'power2.out' });
    const moveY = gsap.quickTo(bg, 'y', { duration: 0.9, ease: 'power2.out' });

    section.addEventListener('pointermove', (e) => {
      const rect = section.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const xNorm = ((e.clientX - rect.left) / rect.width  - 0.5) * 2;
      const yNorm = ((e.clientY - rect.top)  / rect.height - 0.5) * 2;
      moveX(xNorm * -18);
      moveY(yNorm * -12);
    }, { passive: true });
  }

  // GSAP entrance animation (scroll-triggered via IntersectionObserver)
  // NEVER animate opacity on the physical cards to guarantee 100% solid, opaque cards at all times.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const content = section?.querySelector('.container-ember');
    if (content) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            gsap.from(content.querySelectorAll('p, h2, a:not(.tranquility-card a)'), {
              opacity: 0, y: 24, duration: 0.8, stagger: 0.08, ease: 'power3.out',
            });
            gsap.from(content.querySelectorAll('.tranquility-card'), {
              y: 28, duration: 0.8, stagger: 0.12, ease: 'power3.out', clearProps: 'transform',
            });
            observer.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      observer.observe(content);
    }
  }
</script>
