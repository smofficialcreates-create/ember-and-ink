---
/**
 * SceneBooks.astro
 * Scene 02 — Tranquility: Sakura Train Sanctuary
 *
 * All overlays use neutral black/charcoal — zero green tint — so the
 * real illustrated image shows through with its natural warm sakura colours.
 */
import type { BlogPost } from '@lib/posts';
import { formatDate } from '@lib/format';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const displayPosts = posts.slice(0, 3);
---

<section
  id="tranquility-shelf"
  class="scene-anime relative isolate min-h-[900px] py-28 md:py-44 bg-black text-[#fbf6ee] overflow-hidden"
>
  <!-- ░░ HIGH-RES ANIME SAKURA TRAIN BACKGROUND ░░ -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      id="tranquility-bg"
      src="/images/scenes/sakura-train-tranquility.jpg"
      alt="Anime sakura cherry blossom hillside with steam train crossing stone bridge over river at sunrise"
      class="w-full h-full object-cover object-center scale-105"
      loading="lazy"
      decoding="async"
    />
  </div>

  <!-- Left vignette: pure black, no colour cast, for text legibility -->
  <div class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-r from-black/88 via-black/50 to-black/10"></div>
  <!-- Bottom fade to blend into next section -->
  <div class="pointer-events-none absolute inset-0 z-[2] bg-gradient-to-t from-black/92 via-transparent to-black/40"></div>
  <!-- Subtle warm sun glow top-right — amber only, no green -->
  <div class="pointer-events-none absolute -top-24 -right-24 w-[60%] h-[60%] rounded-full blur-3xl bg-gradient-to-bl from-amber-300/15 via-amber-100/6 to-transparent z-[2] mix-blend-screen"></div>

  <!-- ░░ CINEMATIC ANIMATION CANVAS ░░ -->
  <canvas
    id="tranquility-canvas"
    class="pointer-events-none absolute inset-0 z-[4] w-full h-full"
    aria-hidden="true"
  ></canvas>

  <!-- ════════════════════════════════════════════════════
       EDITORIAL CONTENT
  ════════════════════════════════════════════════════ -->
  <div class="container-ember relative z-10">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-16 items-center">

      <!-- Left: Typography & Narrative -->
      <div class="max-w-xl">
        <!-- Section label: soft warm gold, no green -->
        <p class="text-xs uppercase tracking-[0.32em] text-[#e8d5a3] font-semibold mb-4 drop-shadow">
          02 / Experience
        </p>

        <h2 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight drop-shadow-lg">
          Tranquility
        </h2>

        <p class="mt-6 text-base md:text-lg text-white/80 font-light leading-relaxed drop-shadow">
          A cherry-blossom morning on the hillside above the valley. A steam train glides across the stone bridge, petals drift on the gentle breeze, and the river catches the first golden light. Away from algorithmic noise, reading becomes an act of quiet restoration.
        </p>

        <div class="mt-8">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-[#e8d5a3] hover:text-white transition-colors group"
          >
            <span>— Discover all featured books</span>
            <span class="group-hover:translate-x-1.5 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Right: Three Latest Book Cards — neutral dark glass, no green -->
      <div class="space-y-5">
        {displayPosts.map((post, index) => (
          <article class="group relative rounded-3xl border border-white/12 bg-black/55 backdrop-blur-xl p-6 shadow-[0_16px_48px_rgba(0,0,0,0.5)] transition-all duration-400 hover:-translate-y-1.5 hover:border-white/30 hover:bg-black/70">
            <div class="flex flex-col sm:flex-row gap-5 items-start sm:items-center">

              <!-- Book Cover -->
              <div class="relative w-20 h-28 sm:w-24 sm:h-32 rounded-xl overflow-hidden shadow-md flex-shrink-0 bg-neutral-900 border border-white/10">
                {post.data.coverImage ? (
                  <img
                    src={post.data.coverImage}
                    alt={`Cover for ${post.data.title}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-full h-full bg-neutral-800 flex items-center justify-center p-2 text-center text-xs text-[#e8d5a3] font-display">
                    {post.data.title}
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <!-- Category + index: warm gold, no green -->
                <div class="flex items-center justify-between text-xs text-[#e8d5a3]/75 mb-1.5 font-mono">
                  <span class="uppercase tracking-wider">{post.data.category}</span>
                  <span>0{index + 1} / 03</span>
                </div>

                <h3 class="font-display text-xl sm:text-2xl font-semibold text-white group-hover:text-[#e8d5a3] transition-colors line-clamp-1">
                  <a href={`/blog/${post.id}/`} class="focus:outline-none after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h3>

                <p class="mt-2 text-xs sm:text-sm text-white/70 line-clamp-2 font-light leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-3 flex items-center justify-between text-xs text-white/50 pt-2 border-t border-white/10">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span class="text-[#e8d5a3] font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Read review <span>→</span>
                  </span>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  import { mountTranquilityScene } from '../scripts/tranquility-scene.js';
  import gsap from 'gsap';

  // Mount cinematic animation canvas
  const canvas = document.getElementById('tranquility-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    mountTranquilityScene(canvas);
  }

  // 2.5D Mouse Parallax on background (desktop fine-pointer only)
  const bg      = document.getElementById('tranquility-bg');
  const section = document.getElementById('tranquility-shelf');

  if (
    bg && section &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const moveX = gsap.quickTo(bg, 'x', { duration: 0.9, ease: 'power2.out' });
    const moveY = gsap.quickTo(bg, 'y', { duration: 0.9, ease: 'power2.out' });

    section.addEventListener('pointermove', (e) => {
      const rect = section.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const xNorm = ((e.clientX - rect.left) / rect.width  - 0.5) * 2;
      const yNorm = ((e.clientY - rect.top)  / rect.height - 0.5) * 2;
      moveX(xNorm * -18);
      moveY(yNorm * -12);
    }, { passive: true });
  }

  // GSAP entrance animation (scroll-triggered via IntersectionObserver)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const content = section?.querySelector('.container-ember');
    if (content) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            gsap.from(content.querySelectorAll('p, h2, a'), {
              opacity: 0, y: 28, duration: 1, stagger: 0.12, ease: 'power3.out',
            });
            gsap.from(content.querySelectorAll('article'), {
              opacity: 0, y: 32, duration: 0.9, stagger: 0.14, delay: 0.2, ease: 'power3.out',
            });
            observer.disconnect();
          }
        },
        { threshold: 0.15 }
      );
      observer.observe(content);
    }
  }
</script>
