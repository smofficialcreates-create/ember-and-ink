---
/**
 * ReadingProgressBar.astro
 * Reading progress bar fixed at the top of the viewport.
 * Specification: h-1 bg-gold fixed top-0 z-50
 */
---

<div
  id="reading-progress-track"
  class="fixed top-0 inset-x-0 h-1 z-50 pointer-events-none bg-gold/15"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="h-1 bg-gold fixed top-0 z-50 transition-all duration-75 ease-out"
    style="width: 0%;"
  ></div>
</div>

<script>
  function setupProgressBar() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const onScroll = () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        bar.style.width = '0%';
        return;
      }
      const scrolled = (window.scrollY / docHeight) * 100;
      bar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('DOMContentLoaded', setupProgressBar);
  document.addEventListener('astro:page-load', setupProgressBar);
</script>
