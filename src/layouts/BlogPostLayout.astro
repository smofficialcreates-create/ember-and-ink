---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CategoryPill from '@components/CategoryPill.astro';
import RelatedPosts from '@components/RelatedPosts.astro';
import AffiliateDisclosure from '@components/AffiliateDisclosure.astro';
import type { BlogPost } from '@lib/posts';
import { SITE } from '@lib/site';
import { withAmazonTag } from '@lib/amazon';
import { formatDate, readingTime } from '@lib/format';
import { slugify } from '@lib/categories';

interface Props {
  post: BlogPost;
  related: BlogPost[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const amazonUrl = withAmazonTag(post.data.amazonLink);
const goodreadsUrl = `https://www.goodreads.com/search?q=${encodeURIComponent(post.data.title)}`;
const categorySlug = slugify(post.data.category);
const publishedIso = post.data.pubDate.toISOString();
const updatedIso = post.data.updatedDate?.toISOString();
const readTime = readingTime(post.body);
const pageUrl = `${SITE.url}/blog/${post.id}/`;

// Extract headings for Table of Contents
const headings = (post.body || '').match(/^##\s+(.+)$/gm) || [];
const toc = headings.map(h => {
  const text = h.replace(/^##\s+/, '');
  return { text, id: slugify(text) };
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedIso,
  dateModified: updatedIso ?? publishedIso,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
  mainEntityOfPage: pageUrl,
};
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" publishedTime={publishedIso} modifiedTime={updatedIso} image={post.data.coverImage} url={pageUrl}>
  <article class="pb-20">
    <header class="bg-paper border-b border-line">
      <div class="container-ember py-10 md:py-16">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.category, href: `/categories/${categorySlug}/` }, { label: post.data.title }]} />
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <CategoryPill label={post.data.category} slug={categorySlug} />
          <time datetime={publishedIso} class="text-sm text-muted">{formatDate(post.data.pubDate)}</time>
          <span class="text-sm text-muted" aria-hidden="true">•</span>
          <span class="text-sm text-muted">{readTime}</span>
        </div>
        <h1 class="mt-4 text-3xl md:text-5xl leading-tight max-w-3xl">{post.data.title}</h1>
        <p class="mt-4 text-lg text-muted max-w-2xl">{post.data.description}</p>
      </div>
    </header>

    {post.data.coverImage && (
      <div class="container-ember -mt-8 md:-mt-12">
        <div class="rounded-card overflow-hidden shadow-lift bg-paper">
          <img src={post.data.coverImage} alt={post.data.coverAlt ?? `Cover for ${post.data.title}`} class="w-full h-auto max-h-[600px] object-contain" loading="eager" decoding="async" />
        </div>
      </div>
    )}

    <div class="container-ember mt-12">
      <div class="grid md:grid-cols-[minmax(0,1fr)_18rem] gap-12">
        <div class="prose-ember">
          
          {/* BUTTONS */}
          <div class="not-prose mb-8">
            <AffiliateDisclosure />
            <div class="mt-4 flex flex-wrap gap-3">
              {amazonUrl && (
                <a href={amazonUrl} class="inline-flex items-center gap-2 rounded-pill bg-burgundy text-paper px-6 py-3 font-medium shadow-soft hover:bg-burgundy-dark transition-colors" rel="sponsored nofollow noopener noreferrer" target="_blank">
                  Check Price on Amazon →
                </a>
              )}
              <a href={goodreadsUrl} class="inline-flex items-center gap-2 rounded-pill bg-gold-soft text-burgundy px-6 py-3 font-medium hover:bg-gold/40 transition-colors" rel="noopener noreferrer" target="_blank">
                View on Goodreads →
              </a>
            </div>
          </div>

          <Content />

          {/* SOCIAL SHARING */}
          <div class="not-prose mt-12 pt-8 border-t border-line">
            <h3 class="font-display text-lg text-burgundy mb-4">Share this review</h3>
            <div class="flex flex-wrap gap-2">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="rounded-pill bg-cream border border-line px-4 py-2 text-sm hover:border-gold transition-colors">X (Twitter)</a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener" class="rounded-pill bg-cream border border-line px-4 py-2 text-sm hover:border-gold transition-colors">Facebook</a>
              <a href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&description=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener" class="rounded-pill bg-cream border border-line px-4 py-2 text-sm hover:border-gold transition-colors">Pinterest</a>
              <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + ' ' + pageUrl)}`} target="_blank" rel="noopener" class="rounded-pill bg-cream border border-line px-4 py-2 text-sm hover:border-gold transition-colors">WhatsApp</a>
            </div>
          </div>
        </div>

        {/* SIDEBAR */}
        <aside class="space-y-6 md:sticky md:top-24 self-start">
          {toc.length > 0 && (
            <section class="rounded-card bg-paper border border-line p-5 shadow-soft">
              <h2 class="text-lg font-display text-burgundy">In this review</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {toc.map(item => (
                  <li><a href={`#${item.id}`} class="text-muted hover:text-burgundy hover:underline transition-colors">{item.text}</a></li>
                ))}
              </ul>
            </section>
          )}
          <section class="rounded-card bg-paper border border-line p-5 shadow-soft">
            <h2 class="text-lg font-display text-burgundy">Tags</h2>
            {post.data.tags.length > 0 ? (
              <ul class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li><a href={`/tags/${slugify(tag)}/`} class="inline-block rounded-pill border border-line px-3 py-1 text-sm text-muted hover:text-burgundy hover:border-gold transition-colors">#{tag}</a></li>
                ))}
              </ul>
            ) : <p class="mt-3 text-sm text-muted">No tags yet.</p>}
          </section>
        </aside>
      </div>
    </div>
    {related.length > 0 && <RelatedPosts posts={related} />}
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
