---
/**
 * BlogPostLayout.astro
 * High-Converting Editorial Reading Experience for Ember & Ink.
 *
 * CRO Architecture:
 * 1. Metadata & Byline: Dynamic author attribution with 'Reviewed by Ember & Ink' verification.
 * 2. 'Above the Fold' Hero: 2-column grid. Left: 3D-styled physical hardcover. Right: Title, Author, 5-star rating & massive high-contrast pulsing Amazon CTA.
 * 3. 'Why You Should Read This' (TL;DR): 3 bulleted insightsHOOK before review text.
 * 4. Sticky Mobile CTA Bar: Appears on mobile devices (md:hidden) with book thumbnail & 'Buy Now on Amazon' button.
 * 5. The Final Verdict Module: Ornate editorial certificate featuring 'What Stood Out' vs 'Ideal Reader', largest Amazon button & strict FTC disclosure.
 * 6. Editorial Typography & Layout: Fraunces serif headings, Inter body, max-w-prose measure, brand palette (Cream, Deep Burgundy, Gold, Ink).
 */
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import RelatedPosts from '@components/RelatedPosts.astro';
import AffiliateDisclosure from '@components/AffiliateDisclosure.astro';
import ReadingProgressBar from '@components/ReadingProgressBar.astro';
import type { BlogPost } from '@lib/posts';
import { SITE } from '@lib/site';
import { withAmazonTag } from '@lib/amazon';
import { slugify } from '@lib/categories';
import { getBookEditorialMeta } from '@lib/book-meta';

interface Props {
  post: BlogPost;
  related: BlogPost[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const meta = getBookEditorialMeta(post);

const amazonUrl = withAmazonTag(post.data.amazonLink);
const categorySlug = slugify(post.data.category);
const pageUrl = `${SITE.url}/blog/${post.id}/`;

// Extract H2 headings for Table of Contents
const headings = (post.body || '').match(/^##\s+(.+)$/gm) || [];
const toc = headings.map((h) => {
  const text = h.replace(/^##\s+/, '').trim();
  return { text, id: slugify(text) };
});

// Comprehensive Schema.org Review & Book metadata
const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  headline: post.data.title,
  description: post.data.description,
  datePublished: meta.publishedIso,
  dateModified: post.data.updatedDate?.toISOString() ?? meta.publishedIso,
  itemReviewed: {
    '@type': 'Book',
    name: meta.bookTitle,
    author: {
      '@type': 'Person',
      name: meta.author,
    },
    image: `${SITE.url}${meta.coverImage}`,
  },
  reviewRating: meta.rating
    ? {
        '@type': 'Rating',
        ratingValue: meta.rating,
        bestRating: 5,
        worstRating: 1,
      }
    : undefined,
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: pageUrl,
};
---

<BaseLayout
  title={`${meta.bookTitle} by ${meta.author} — Book Review & Summary`}
  description={post.data.description}
  type="article"
  publishedTime={meta.publishedIso}
  modifiedTime={post.data.updatedDate?.toISOString()}
  image={meta.coverImage}
  url={pageUrl}
>
  {/* Reading Progress Indicator fixed at top */}
  <ReadingProgressBar />

  <article class="pb-24 selection:bg-gold-soft/50">
    
    {/* ══════════════════════════════════════════════════════════════════════════
        1 & 2. 'ABOVE THE FOLD' SALES HERO & METADATA
    ══════════════════════════════════════════════════════════════════════════ */}
    <header class="relative isolate overflow-hidden bg-gradient-to-b from-[#f7f2e8] via-cream to-paper pt-8 pb-12 md:pt-12 md:pb-16 border-b border-line" id="top">
      {/* Background Japanese Watermark */}
      <div class="pointer-events-none absolute right-4 top-8 opacity-[0.035] select-none text-[16rem] md:text-[22rem] font-serif font-bold text-burgundy">
        評
      </div>

      <div class="container-ember relative z-10">
        
        {/* Breadcrumb Trail & Quick FTC Header */}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
          <Breadcrumbs
            items={[
              { label: 'Home', href: '/' },
              { label: 'The Reading Room', href: '/reviews/' },
              { label: meta.curatedShelf.shortName, href: `/categories/${categorySlug}/` },
              { label: meta.bookTitle },
            ]}
          />
          <div class="text-[11px] text-muted font-light flex items-center gap-1.5 shrink-0">
            <span class="text-gold font-bold">ⓘ</span>
            <span>As an Amazon Associate, Ember &amp; Ink earns from qualifying purchases.</span>
          </div>
        </div>

        {/* 2-Column Hero Grid: Left = 3D Hardcover Book / Right = Title, Author, Rating & High-Converting CTA Box */}
        <div class="grid md:grid-cols-[0.8fr_1.2fr] gap-8 lg:gap-14 items-center">
          
          {/* Left Column: 3D Interactive Hardcover Book Presentation */}
          <div class="flex items-center justify-center md:justify-start">
            <div class="relative w-52 sm:w-64 md:w-72 aspect-[2/3] transition-transform duration-500 hover:scale-[1.03] hover:-rotate-1">
              
              {/* Pedestal shadow on tabletop */}
              <div class="absolute -bottom-6 inset-x-3 h-8 bg-black/35 blur-xl rounded-full"></div>

              {/* 3D Physical Hardbound Book */}
              <div class="relative h-full w-full rounded-r-xl rounded-l-[3px] overflow-hidden shadow-[8px_22px_44px_-6px_rgba(42,33,24,0.45)] border border-black/15 bg-[#1b1419]">
                <img
                  src={meta.coverImage}
                  alt={meta.coverAlt}
                  class="h-full w-full object-cover object-center"
                  loading="eager"
                  decoding="async"
                  width="360"
                  height="540"
                />

                {/* Hardcover Left Spine Lighting & Bevel */}
                <div class="pointer-events-none absolute inset-y-0 left-0 w-4 bg-gradient-to-r from-black/45 via-white/20 to-transparent"></div>
                {/* Book Edge Trim */}
                <div class="pointer-events-none absolute inset-y-0 right-0 w-[2px] bg-gradient-to-b from-amber-100/50 via-amber-50/25 to-amber-100/50"></div>
                {/* Surface Sheen */}
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/15"></div>
              </div>

              {/* Japanese Book Seal */}
              <div class="pointer-events-none absolute -bottom-3 -right-3 h-11 w-11 rounded-full bg-[#5c1f2c] border border-gold-soft text-gold-soft flex items-center justify-center font-serif text-sm shadow-lg">
                <span>印</span>
              </div>
            </div>
          </div>

          {/* Right Column: Title, Author, Subheading & Instant Sales Hook */}
          <div class="space-y-6">
            
            {/* Reviewed By Subheading & Shelf Badge */}
            <div class="flex flex-wrap items-center gap-3 text-xs">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-burgundy/10 border border-burgundy/25 px-3 py-1 font-semibold uppercase tracking-wider text-burgundy shadow-2xs">
                <span class="text-gold" aria-hidden="true">✦</span>
                <span>Reviewed by Ember &amp; Ink</span>
              </span>

              <span class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-medium border border-current/25 shadow-2xs', meta.curatedShelf.badgeBg, meta.curatedShelf.badgeText]}>
                <span aria-hidden="true">{meta.curatedShelf.motif}</span>
                <span>{meta.curatedShelf.name}</span>
              </span>

              <span class="text-muted/60 font-mono text-[11px]">•</span>
              <span class="text-muted font-mono text-xs">{meta.readTime}</span>
            </div>

            {/* Dynamic Author Byline & Monumental Title */}
            <div class="space-y-2">
              <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-burgundy tracking-tight leading-[1.08]">
                {meta.bookTitle}
              </h1>
              <p class="font-display text-lg sm:text-xl text-ink font-medium">
                By <span class="text-burgundy font-semibold">{meta.author}</span>
              </p>
              <p class="text-xs uppercase tracking-widest text-muted font-medium pt-1">
                Reviewed by Ember &amp; Ink Literary Staff
              </p>
            </div>

            {/* Rating / Quality Badge */}
            <div class="flex flex-wrap items-center gap-3">
              {meta.ratingStars ? (
                <div class="inline-flex items-center gap-2 rounded-2xl bg-paper border border-gold/40 px-3.5 py-1.5 shadow-2xs">
                  <span class="font-mono text-gold tracking-widest text-sm">{meta.ratingStars}</span>
                  <span class="text-xs font-semibold font-mono text-burgundy">{meta.rating} / 5</span>
                </div>
              ) : (
                <div class="inline-flex items-center gap-1.5 rounded-full bg-gold-soft/40 border border-gold/30 px-3 py-1 text-xs font-semibold text-burgundy">
                  <span>Curated Selection</span>
                </div>
              )}
              <span class="text-xs font-mono text-muted/80">
                Published {meta.publishedFormatted}
              </span>
            </div>

            {/* 2. THE 'ABOVE THE FOLD' SALES HOOK BOX */}
            {amazonUrl && (
              <div class="rounded-2xl border-2 border-gold/50 bg-gradient-to-br from-[#fffdf7] via-[#fdf9f0] to-[#f7f0e1] p-5 sm:p-6 shadow-soft space-y-4">
                <div class="flex items-center justify-between text-xs">
                  <span class="inline-flex items-center gap-2 font-bold uppercase tracking-wider text-burgundy">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span>Verified Amazon Listing</span>
                  </span>
                  <span class="font-mono text-[11px] text-muted hidden sm:inline">Prime 1-Day Eligible</span>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <p class="text-xs text-muted font-medium">Format Options</p>
                    <p class="font-display text-sm sm:text-base font-semibold text-burgundy">Hardcover · Paperback · Kindle</p>
                  </div>

                  {/* Pulsing Gold/Burgundy High-Converting Button */}
                  <a
                    href={amazonUrl}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                    class="relative inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-burgundy via-[#8c2b3f] to-burgundy text-[#fffdf7] font-bold text-sm sm:text-base px-7 py-3 shadow-[0_8px_20px_rgba(92,31,44,0.35)] hover:shadow-[0_12px_28px_rgba(92,31,44,0.5)] hover:scale-105 active:scale-95 transition-all group amazon-pulse-btn"
                  >
                    <span>Check Price on Amazon</span>
                    <span class="text-gold-soft text-lg transition-transform group-hover:translate-x-1" aria-hidden="true">&nearr;</span>
                  </a>
                </div>

                <div class="pt-2 border-t border-line/60 flex items-center justify-between text-[11px] text-muted font-mono">
                  <span>✓ Fast Prime Delivery</span>
                  <span>✓ Official Publisher Edition</span>
                  <a href="#review-content" class="text-burgundy hover:underline font-semibold font-sans">
                    Read Review ↓
                  </a>
                </div>
              </div>
            )}

          </div>

        </div>

      </div>
    </header>

    {/* ══════════════════════════════════════════════════════════════════════════
        4. STICKY MOBILE BUY BAR (Maximizing Mobile CRO: md:hidden)
    ══════════════════════════════════════════════════════════════════════════ */}
    {amazonUrl && (
      <div
        id="mobile-sticky-buy-bar"
        class="fixed bottom-0 inset-x-0 z-50 md:hidden bg-paper/95 backdrop-blur-md border-t border-line px-4 py-3 shadow-[0_-8px_24px_rgba(42,33,24,0.18)] flex items-center justify-between gap-3"
      >
        <div class="flex items-center gap-2.5 min-w-0">
          <img
            src={meta.coverImage}
            alt={meta.bookTitle}
            class="h-10 w-7 rounded object-cover shadow-2xs shrink-0 border border-black/10"
            loading="lazy"
            decoding="async"
          />
          <div class="min-w-0">
            <p class="font-display text-xs font-semibold text-burgundy truncate">{meta.bookTitle}</p>
            <p class="text-[10px] text-muted font-mono truncate">Available on Amazon</p>
          </div>
        </div>

        <a
          href={amazonUrl}
          target="_blank"
          rel="sponsored nofollow noopener noreferrer"
          class="inline-flex min-h-10 shrink-0 items-center justify-center gap-1.5 rounded-full bg-gradient-to-r from-burgundy to-[#8c2b3f] px-5 py-2 text-xs font-bold uppercase tracking-wider text-[#fffaf0] shadow-md active:scale-95 transition-transform amazon-pulse-btn"
        >
          <span>Buy Now on Amazon</span>
          <span aria-hidden="true">&nearr;</span>
        </a>
      </div>
    )}

    {/* ══════════════════════════════════════════════════════════════════════════
        3. THE 'WHY YOU SHOULD READ THIS' (TL;DR) & EDITORIAL READING BODY
    ══════════════════════════════════════════════════════════════════════════ */}
    <div class="container-ember mt-10 md:mt-14" id="review-content">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-12 lg:gap-16 items-start">
        
        {/* Main Column: Review Text & Final Verdict Certificate */}
        <div class="min-w-0">
          
          {/* Prominent FTC Banner Disclosure */}
          <div class="mb-8">
            <AffiliateDisclosure banner={true} />
          </div>

          {/* 3. THE 'WHY YOU SHOULD READ THIS' (TL;DR) HOOK */}
          <div class="not-prose mb-10 rounded-2xl border-2 border-gold/45 bg-gradient-to-br from-[#fffdf7] via-[#fbf7ee] to-[#f7f0e3] p-6 sm:p-7 shadow-soft">
            <div class="flex items-center justify-between pb-3 border-b border-line/70">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-burgundy">
                <span class="text-gold text-base" aria-hidden="true">✦</span>
                <span>Why You Should Read This</span>
              </div>
              <span class="text-[11px] font-mono text-muted uppercase tracking-wider hidden sm:inline">Executive Summary</span>
            </div>

            <p class="mt-4 text-base font-serif italic text-ink/90 leading-relaxed">
              “{meta.verdictShort}”
            </p>

            <div class="mt-5 pt-4 border-t border-line/50">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted mb-2.5">Key Highlights:</p>
              <ul class="space-y-2 text-xs sm:text-sm text-ink/85">
                {meta.highlights.map((point) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✓</span>
                    <span class="font-light">{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            {amazonUrl && (
              <div class="mt-6 pt-4 border-t border-line/60 flex flex-col sm:flex-row items-center justify-between gap-3">
                <span class="text-xs text-muted font-light">Ready to dive in? Get your copy directly:</span>
                <a
                  href={amazonUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-full bg-burgundy px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-[#fffdf7] shadow-2xs hover:bg-burgundy-dark transition-colors"
                >
                  <span>Check Price on Amazon</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              </div>
            )}
          </div>

          {/* Editorial Reading Typography (Fraunces + Inter, max-w-prose / max-w-3xl) */}
          <div class="prose-ember max-w-prose max-w-3xl leading-relaxed text-ink/90 font-body text-base sm:text-lg">
            <Content />
          </div>

          {/* ══════════════════════════════════════════════════════════════════
              5. THE 'FINAL VERDICT' FRAMED EDITORIAL CERTIFICATE
          ══════════════════════════════════════════════════════════════════ */}
          <section
            id="final-verdict"
            class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-b from-[#fbf7ef] via-[#fffdf7] to-[#f5ede0] border-4 border-[#d8c7ad] p-8 sm:p-12 md:p-14 shadow-[0_20px_50px_-12px_rgba(42,33,24,0.18)] my-16 not-prose"
            aria-label="Editorial Verdict Certificate"
          >
            {/* Certificate Ornate Corners */}
            <div class="pointer-events-none absolute top-3 left-3 text-gold/40 text-xl font-serif select-none">⌜</div>
            <div class="pointer-events-none absolute top-3 right-3 text-gold/40 text-xl font-serif select-none">⌝</div>
            <div class="pointer-events-none absolute bottom-3 left-3 text-gold/40 text-xl font-serif select-none">⌞</div>
            <div class="pointer-events-none absolute bottom-3 right-3 text-gold/40 text-xl font-serif select-none">⌟</div>

            {/* Header with Ember & Ink Seal */}
            <div class="text-center max-w-xl mx-auto space-y-3 pb-8 border-b border-line/80">
              <div class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-burgundy text-gold-soft border-2 border-gold mx-auto shadow-md font-serif text-lg">
                <span>❦</span>
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.28em] text-[#9b3c4a]">
                Official Critical Evaluation
              </p>
              <h2 class="font-display text-3xl sm:text-4xl text-burgundy font-bold">
                The Final Verdict
              </h2>
              <p class="font-display text-lg text-ink font-medium">
                {meta.bookTitle} <span class="text-muted font-normal">by</span> {meta.author}
              </p>

              {meta.ratingStars ? (
                <div class="inline-flex items-center gap-2 bg-[#fffdf7] border border-gold/50 rounded-2xl px-5 py-2 shadow-2xs mt-2">
                  <span class="font-mono text-xl text-gold tracking-widest">{meta.ratingStars}</span>
                  <span class="text-sm font-mono font-bold text-burgundy">{meta.rating} / 5</span>
                </div>
              ) : (
                <span class="inline-block rounded-full bg-gold-soft/50 border border-gold/40 px-4 py-1 text-xs font-semibold text-burgundy">
                  Curated Recommendation
                </span>
              )}
            </div>

            {/* Synthesis Quote */}
            <div class="my-8 max-w-2xl mx-auto text-center">
              <blockquote class="font-display text-xl sm:text-2xl italic text-ink/90 leading-relaxed">
                “{meta.verdictShort}”
              </blockquote>
            </div>

            {/* Side-by-Side: What Stood Out vs Ideal Reader */}
            <div class="grid sm:grid-cols-2 gap-6 my-8 max-w-3xl mx-auto">
              <div class="bg-paper rounded-2xl p-6 border border-line shadow-2xs">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#2e593a] mb-3">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 text-[11px]">✓</span>
                  <span>What Stood Out</span>
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-ink/80 font-light">
                  {meta.highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-600 mt-0.5">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="bg-paper rounded-2xl p-6 border border-line shadow-2xs">
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#7a4d2b] mb-3">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-amber-100 text-amber-800 text-[11px]">❦</span>
                  <span>Ideal Reader</span>
                </div>
                <p class="text-xs sm:text-sm text-ink/80 font-light leading-relaxed">
                  Essential reading for lovers of <strong>{meta.genre}</strong> looking for depth, craft, and an unforgettable story that stays with you long after the final page.
                </p>
              </div>
            </div>

            {/* LARGEST CALL TO ACTION BUTTON ON THE ENTIRE PAGE */}
            {amazonUrl && (
              <div class="text-center pt-8 border-t border-line/80 max-w-xl mx-auto space-y-4">
                <a
                  href={amazonUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener noreferrer"
                  class="relative w-full sm:w-auto inline-flex min-h-16 items-center justify-center gap-3 rounded-full bg-gradient-to-r from-burgundy via-[#8c2b3f] to-burgundy px-10 py-4 text-base sm:text-lg font-bold uppercase tracking-widest text-[#fffaf0] shadow-[0_12px_32px_rgba(92,31,44,0.4)] hover:shadow-[0_16px_40px_rgba(92,31,44,0.6)] hover:scale-105 active:scale-95 transition-all amazon-pulse-btn"
                >
                  <span>Find This Book on Amazon</span>
                  <span class="text-gold-soft text-xl" aria-hidden="true">&nearr;</span>
                </a>

                {/* Explicit FTC Disclosure as requested */}
                <p class="text-xs text-muted/80 font-light leading-relaxed">
                  As an Amazon Associate, Ember &amp; Ink earns from qualifying purchases.
                </p>
              </div>
            )}
          </section>

          {/* Bottom Social Share & Navigation Row */}
          <div class="mt-12 pt-8 border-t border-line not-prose flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.22em] text-muted mb-3">
                Share This Literary Note
              </h3>
              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(pageUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-cream border border-line px-4 py-2 text-xs font-medium text-ink hover:border-gold hover:text-burgundy transition-colors"
                >
                  X (Twitter)
                </a>
                <a
                  href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(pageUrl)}&description=${encodeURIComponent(post.data.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-cream border border-line px-4 py-2 text-xs font-medium text-ink hover:border-gold hover:text-burgundy transition-colors"
                >
                  Pinterest
                </a>
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + ' ' + pageUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-cream border border-line px-4 py-2 text-xs font-medium text-ink hover:border-gold hover:text-burgundy transition-colors"
                >
                  WhatsApp
                </a>
                <button
                  type="button"
                  id="copy-link-btn"
                  class="rounded-full bg-cream border border-line px-4 py-2 text-xs font-medium text-ink hover:border-gold hover:text-burgundy transition-colors"
                >
                  Copy Link
                </button>
              </div>
            </div>

            <div class="text-left sm:text-right">
              <a
                href="/reviews/"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-burgundy hover:text-gold transition-colors"
              >
                <span>← Return to The Reading Room</span>
              </a>
            </div>
          </div>

        </div>

        {/* Sidebar: Sticky Desktop Table of Contents & Book Dossier */}
        <aside class="hidden lg:block space-y-8 sticky top-24 self-start">
          
          {/* Table of Contents Card with Scroll-Spy */}
          {toc.length > 0 && (
            <section class="rounded-2xl bg-paper border border-line p-6 shadow-sm" aria-label="Table of contents">
              <div class="flex items-center justify-between pb-3 border-b border-line">
                <h2 class="font-display text-base font-semibold text-burgundy">
                  In This Review
                </h2>
                <span class="text-[10px] font-mono uppercase tracking-widest text-muted">
                  Index
                </span>
              </div>

              <ul class="mt-4 space-y-2.5 text-xs text-muted" id="desktop-toc">
                {toc.map((item) => (
                  <li>
                    <a
                      href={`#${item.id}`}
                      class="toc-link block py-1 pl-2 border-l-2 border-transparent hover:border-gold hover:text-burgundy transition-all"
                      data-target-id={item.id}
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
                <li>
                  <a
                    href="#final-verdict"
                    class="toc-link block py-1 pl-2 border-l-2 border-transparent font-semibold text-[#9b3c4a] hover:border-gold hover:text-burgundy transition-all"
                    data-target-id="final-verdict"
                  >
                    The Final Verdict ⚖
                  </a>
                </li>
              </ul>
            </section>
          )}

          {/* Book Dossier Summary Card with Quick Purchase Button */}
          <section class="rounded-2xl bg-[#fffdf7] border-2 border-gold/40 p-6 shadow-soft space-y-4">
            <h3 class="font-display text-base font-semibold text-burgundy border-b border-line pb-2">
              Book Details
            </h3>

            <div class="space-y-3 text-xs">
              <div class="flex justify-between items-center py-1 border-b border-line/40">
                <span class="text-muted">Author</span>
                <span class="font-semibold text-ink">{meta.author}</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-line/40">
                <span class="text-muted">Genre</span>
                <span class="font-semibold text-ink">{meta.genre}</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-line/40">
                <span class="text-muted">Shelf</span>
                <span class="font-semibold text-ink">{meta.curatedShelf.shortName}</span>
              </div>
              <div class="flex justify-between items-center py-1 border-b border-line/40">
                <span class="text-muted">Reviewed</span>
                <span class="font-mono text-ink">{meta.publishedFormatted}</span>
              </div>
              {meta.ratingStars && (
                <div class="flex justify-between items-center py-1 border-b border-line/40">
                  <span class="text-muted">Rating</span>
                  <span class="text-gold font-mono tracking-widest">{meta.ratingStars}</span>
                </div>
              )}
            </div>

            {amazonUrl && (
              <div class="pt-2">
                <a
                  href={amazonUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener noreferrer"
                  class="w-full inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-burgundy via-[#8c2b3f] to-burgundy px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-[#fffaf0] hover:scale-102 transition-transform shadow-sm"
                >
                  <span>Check Price on Amazon</span>
                  <span class="text-xs">&nearr;</span>
                </a>
              </div>
            )}
          </section>

          {/* Tags Cloud */}
          {post.data.tags.length > 0 && (
            <section class="rounded-2xl bg-paper border border-line p-5 shadow-2xs">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-muted mb-3">
                Tags &amp; Tropes
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <a
                    href={`/tags/${slugify(tag)}/`}
                    class="rounded-full border border-line bg-cream/60 px-3 py-1 text-[11px] text-muted hover:border-gold hover:text-burgundy transition-colors"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </section>
          )}

        </aside>

      </div>
    </div>

    {/* Further Literary Inquiries (Related Books) */}
    {related.length > 0 && <RelatedPosts posts={related} />}

  </article>

  {/* Schema.org Article Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
</BaseLayout>

{/* ══════════════════════════════════════════════════════════════════════════
    SCROLL-SPY TOC & COPY LINK SCRIPT
══════════════════════════════════════════════════════════════════════════ */}
<script>
  function setupReadingPage() {
    // Copy link helper
    const copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied! ✓';
          setTimeout(() => {
            copyBtn.textContent = original;
          }, 2000);
        } catch {
          // Fallback
        }
      });
    }

    // Scroll-Spy for Table of Contents
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headingTargets: HTMLElement[] = [];
    tocLinks.forEach((link) => {
      const targetId = link.dataset.targetId;
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el) headingTargets.push(el);
      }
    });

    if (headingTargets.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              if (link.dataset.targetId === id) {
                link.classList.add('border-burgundy', 'text-burgundy', 'font-semibold');
                link.classList.remove('border-transparent', 'text-muted');
              } else {
                link.classList.remove('border-burgundy', 'text-burgundy', 'font-semibold');
                link.classList.add('border-transparent', 'text-muted');
              }
            });
          }
        });
      },
      {
        rootMargin: '-10% 0px -75% 0px',
        threshold: 0,
      }
    );

    headingTargets.forEach((target) => observer.observe(target));
  }

  document.addEventListener('DOMContentLoaded', setupReadingPage);
  document.addEventListener('astro:page-load', setupReadingPage);
</script>

