---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { CATEGORIES, type Category } from '@lib/categories';
import { getPostsByCategory } from '@lib/posts';
import { SITE } from '@lib/site';

export const getStaticPaths: GetStaticPaths = () =>
  CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));

interface Props {
  category: Category;
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.label);
---

<BaseLayout
  title={`${category.label} Reviews & Essays`}
  description={`${category.description} Reviews and reading lists for ${category.label} at Ember & Ink.`}
  url={`${SITE.url}/categories/${category.slug}/`}
>
  <section class="container-ember py-16 md:py-24">
    <header class="max-w-2xl">
      <p class="text-sm uppercase tracking-[0.2em] text-muted">
        Category
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl text-burgundy">
        {category.label}
      </h1>
      <p class="mt-4 text-lg text-muted">{category.description}</p>
      <p class="mt-2 text-sm text-muted">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </header>

    {posts.length === 0 ? (
      <div class="mt-12 rounded-card bg-paper border border-line p-8 text-center">
        <p class="text-muted">
          Nothing on this shelf yet — check back soon, or
          <a href="/blog/" class="underline hover:text-burgundy">
            browse every post
          </a>
          .
        </p>
      </div>
    ) : (
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => <PostCard post={post} eager={i < 3} />)}
      </div>
    )}

    <div class="mt-14">
      <a href="/categories/" class="text-sm font-medium text-burgundy hover:underline">
        ← All categories
      </a>
    </div>
  </section>
</BaseLayout>