---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import { SITE } from '@lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Ember & Ink — review requests, collaborations, corrections, or just to say hello."
  url={`${SITE.url}/contact/`}
>
  <section class="container-ember py-16 md:py-24 max-w-3xl">
    <header>
      <p class="text-sm uppercase tracking-[0.2em] text-muted">Contact</p>
      <h1 class="mt-3 text-4xl md:text-5xl text-burgundy">Say hello.</h1>
      <p class="mt-4 text-lg text-muted">
        Found a book we should read? A review you disagree with? A genre
        we've under-covered? Write to us — we read every message.
      </p>
    </header>

    <div class="mt-10 grid md:grid-cols-[1fr_16rem] gap-10">
      <div>
        <ContactForm />
      </div>

      <aside class="space-y-6 text-sm">
        <div>
          <h2 class="font-display text-lg text-burgundy">Email</h2>
          <p class="mt-1">
            <a href={`mailto:${SITE.email}`} class="underline hover:text-burgundy">
              {SITE.email}
            </a>
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg text-burgundy">Review requests</h2>
          <p class="mt-1 text-muted">
            Authors and publishers: include the title, genre, and a short
            synopsis. We cannot promise to review every submission, and we
            never guarantee a positive review.
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg text-burgundy">Response time</h2>
          <p class="mt-1 text-muted">
            We usually reply within a few days. If you don't hear back after
            a week, feel free to nudge us.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>