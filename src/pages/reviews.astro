---
import BaseLayout from '@layouts/BaseLayout.astro';
import ReviewsSection from '@components/ReviewsSection.astro';
import PostCard from '@components/PostCard.astro';
import { getPublishedPosts } from '@lib/posts';
import { SITE } from '@lib/site';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout
  title="Reviews"
  description="Reader reviews of Ember & Ink, plus the latest book reviews from the site."
  url={`${SITE.url}/reviews/`}
>
  <section class="container-ember py-16 md:py-24">
    <header class="max-w-2xl">
      <p class="text-sm uppercase tracking-[0.2em] text-muted">Reviews</p>
      <h1 class="mt-3 text-4xl md:text-5xl text-burgundy">
        Honest opinions, from books and readers alike.
      </h1>
      <p class="mt-4 text-lg text-muted">
        Every book review here is written by a human who read the whole
        book. Every reader testimonial is shared with permission — and
        never invented.
      </p>
    </header>

    <div class="mt-10">
      <ReviewsSection />
    </div>

    <div class="mt-16">
      <div class="flex items-end justify-between gap-4 mb-6">
        <h2 class="text-2xl md:text-3xl">Latest book reviews</h2>
        <a href="/blog/" class="text-sm font-medium text-burgundy hover:underline shrink-0">
          All posts →
        </a>
      </div>

      {posts.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="text-muted">No book reviews published yet — check back soon.</p>
      )}
    </div>
  </section>
</BaseLayout>
