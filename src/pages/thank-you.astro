---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@lib/site';
---

<BaseLayout
  title="Thank you"
  description="Your message was received — thanks for reaching out to Ember & Ink."
  url={`${SITE.url}/thank-you/`}
  noindex
>
  <section class="container-ember py-20 md:py-28 text-center max-w-2xl">
    <p class="text-5xl" aria-hidden="true">📖</p>
    <h1 class="mt-6 text-4xl md:text-5xl text-burgundy">
      Thank you.
    </h1>
    <p class="mt-4 text-lg text-muted">
      Your message landed. We read every one — expect a reply within a few
      days. In the meantime, there's a shelf full of good books waiting.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="/blog/"
        class="rounded-pill bg-burgundy text-paper px-6 py-3 font-medium hover:bg-burgundy-dark transition-colors"
      >
        Browse the blog
      </a>
      <a
        href="/categories/"
        class="rounded-pill bg-gold-soft text-burgundy px-6 py-3 font-medium hover:bg-gold/40 transition-colors"
      >
        All categories
      </a>
      <a
        href="/"
        class="rounded-pill border border-line px-6 py-3 font-medium hover:border-gold transition-colors"
      >
        Home
      </a>
    </div>
  </section>
</BaseLayout>