---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { getPublishedPosts, getFeaturedPosts } from '@lib/posts';
import { CATEGORIES } from '@lib/categories';
import { SITE } from '@lib/site';
import { NEWSLETTER_ENDPOINT } from '@lib/forms';

const all = await getPublishedPosts();
const featured = await getFeaturedPosts(1);
const lead = featured[0] ?? all[0];
const others = all.filter((p) => p.id !== lead?.id).slice(0, 3);
const topCategories = CATEGORIES.slice(0, 8);
---

<BaseLayout title="Home" description={SITE.description} url={`${SITE.url}/`}>
  {/* Hero */}
  <section class="relative overflow-hidden bg-gradient-to-b from-cream via-paper to-cream">
    <div class="container-ember py-16 md:py-24 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-muted mb-4">
          Self-Help &amp; Fantasy Romance
        </p>
        <h1 class="font-display text-4xl md:text-6xl leading-[1.05] text-burgundy">
          Warm reviews for<br />
          <span class="text-gold">books that stay</span><br />
          with you.
        </h1>
        <p class="mt-6 text-lg text-muted max-w-xl">
          Honest reviews, thoughtful essays, and carefully curated reading
          lists — from grounded self-help to sweeping fantasy romance.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/categories/self-help/"
            class="inline-flex items-center rounded-pill bg-burgundy text-paper px-6 py-3 font-medium shadow-soft hover:bg-burgundy-dark transition-colors"
          >
            Self-Help →
          </a>
          <a
            href="/categories/fantasy-romance/"
            class="inline-flex items-center rounded-pill bg-gold-soft text-burgundy px-6 py-3 font-medium hover:bg-gold/40 transition-colors"
          >
            Fantasy Romance →
          </a>
        </div>
      </div>

      {lead && (
        <div class="relative">
          <div class="absolute -inset-4 bg-gold/10 rounded-[2rem] blur-2xl" aria-hidden="true"></div>
          <div class="relative">
            <PostCard post={lead} eager />
          </div>
        </div>
      )}
    </div>
  </section>

  {/* Fresh from the shelf */}
  {others.length > 0 && (
    <section class="container-ember py-12 md:py-16">
      <div class="flex items-end justify-between gap-4 mb-8">
        <h2 class="text-3xl md:text-4xl">Fresh from the shelf</h2>
        <a href="/blog/" class="text-sm font-medium text-burgundy hover:underline shrink-0">
          All posts →
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {others.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  {/* Category grid */}
  <section class="bg-paper border-y border-line">
    <div class="container-ember py-16 md:py-20">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl md:text-4xl">Browse by shelf</h2>
          <p class="mt-2 text-muted">Every genre has a corner here.</p>
        </div>
        <a href="/categories/" class="text-sm font-medium text-burgundy hover:underline shrink-0">
          All categories →
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {topCategories.map((cat) => (
          <a
            href={`/categories/${cat.slug}/`}
            class:list={[
              'rounded-card border p-4 transition-colors',
              cat.featured
                ? 'bg-burgundy text-paper border-burgundy hover:bg-burgundy-dark'
                : 'bg-cream border-line hover:border-gold',
            ]}
          >
            <p class:list={[
              'font-display text-lg',
              cat.featured ? 'text-gold' : 'text-burgundy',
            ]}>
              {cat.label}
            </p>
            <p class:list={[
              'mt-1 text-xs leading-snug',
              cat.featured ? 'text-cream/70' : 'text-muted',
            ]}>
              {cat.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Newsletter */}
  <section class="container-ember py-16 md:py-20">
    <div class="rounded-card bg-burgundy text-cream p-8 md:p-12 grid md:grid-cols-2 gap-8 items-center shadow-lift">
      <div>
        <h2 class="text-3xl text-gold">A slow letter, once a month.</h2>
        <p class="mt-3 text-cream/80">
          New reviews, quiet recommendations, and the occasional reading list.
          No spam, ever.
        </p>
      </div>

      {NEWSLETTER_ENDPOINT ? (
        <form
          action={NEWSLETTER_ENDPOINT}
          method="POST"
          class="flex flex-col sm:flex-row gap-3"
          data-protected-form
        >
          <label class="sr-only" for="home-email">Email address</label>
          <input
            id="home-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="flex-1 rounded-pill bg-paper text-ink px-5 py-3 placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-gold"
          />
          {/* Honeypot — hidden from humans, bots fill it, script redirects to /thank-you/ */}
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="_next" value="/thank-you/" />
          <button
            type="submit"
            class="rounded-pill bg-gold text-burgundy-dark px-6 py-3 font-medium hover:bg-gold-soft transition-colors"
          >
            Subscribe
          </button>
        </form>
      ) : (
        <p class="text-cream/80">
          <a
            href={`mailto:${SITE.email}?subject=Newsletter`}
            class="underline text-gold hover:text-gold-soft"
          >
            Email us to join the list →
          </a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>