---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroDreamscape from '@components/HeroDreamscape.astro';
import SceneBooks from '@components/SceneBooks.astro';
import SceneGenres from '@components/SceneGenres.astro';
import SceneLibrary from '@components/SceneLibrary.astro';
import SceneReviews from '@components/SceneReviews.astro';
import SceneAbout from '@components/SceneAbout.astro';
import SceneNight from '@components/SceneNight.astro';
import { getPublishedPosts, getFeaturedPosts } from '@lib/posts';
import { CATEGORIES } from '@lib/categories';
import { SITE } from '@lib/site';
import { NEWSLETTER_ENDPOINT } from '@lib/forms';
import '@styles/scenes.css';

const all = await getPublishedPosts();
const featured = await getFeaturedPosts(3);
---

<BaseLayout title="Home" description={SITE.description} url={`${SITE.url}/`}>
  <!-- Scene 01: Hero — The Spring Countryside Hillside (VISITE / EMBER & INK) -->
  <HeroDreamscape />
  
  <!-- Editorial Reading Strip: Seamless atmospheric bridge -->
  <section class="relative z-20 border-y border-white/10 bg-[#140e1e] text-[#fbf6ee]">
    <div class="container-ember flex flex-col items-center justify-between gap-3 py-5 sm:flex-row">
      <div class="flex items-center gap-3">
        <span class="text-2xl" aria-hidden="true">📖</span>
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.24em] text-[#e8d5a3]">Currently reading on the veranda</p>
          <p class="font-display text-lg text-white">The Midnight Library <span class="text-sm text-white/60">by Matt Haig</span></p>
        </div>
      </div>
      <a href="/blog/" class="text-xs uppercase tracking-widest font-semibold text-[#e8d5a3] hover:text-white transition-colors">
        Browse all reviews ↗
      </a>
    </div>
  </section>

  <!-- Scene 02: Tranquility — The Waterfall & Nature Sanctuary -->
  <SceneBooks posts={featured} />

  <!-- Scene 03: Atmospheric Portals — Six Realms of Literature -->
  <SceneGenres categories={CATEGORIES} />

  <!-- Scene 04: The Archive — The Hillside Countryside Library -->
  <SceneLibrary posts={all} />

  <!-- Scene 05: The Open Tome — Two-Page Editorial Examination -->
  <SceneReviews posts={featured} />

  <!-- Scene 06: The Journey — Japanese Countryside Village & Ethos -->
  <SceneAbout />

  <!-- Scene 07: The Night Garden — Nocturnal Mountain Sky, Fireflies & The Letter -->
  <SceneNight newsletterEndpoint={NEWSLETTER_ENDPOINT} siteEmail={SITE.email} />
</BaseLayout>

<script>
  import '../scripts/scroll-orchestrator.js';
</script>

