---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import HeroDreamscape from '@components/HeroDreamscape.astro';
import { getPublishedPosts, getFeaturedPosts } from '@lib/posts';
import { CATEGORIES } from '@lib/categories';
import { SITE } from '@lib/site';

const all = await getPublishedPosts();
const featured = await getFeaturedPosts(1);
const others = all.filter((p) => p.id !== featured[0]?.id).slice(0, 3);
---

<BaseLayout title="Home" description={SITE.description} url={`${SITE.url}/`}>
  
  <!-- 1. The Cinematic Hero -->
  <HeroDreamscape />

  <!-- 2. Immersive Story Intro (Reveals on scroll) -->
  <section class="py-32 md:py-48 bg-[#fbf6ee] relative z-20">
    <div class="container-ember text-center max-w-4xl mx-auto reveal-text">
      <h2 class="font-display text-4xl md:text-6xl text-burgundy leading-tight">
        We believe the right book <br/>
        <span class="italic text-gold">finds you</span> at the right time.
      </h2>
      <p class="mt-8 text-xl text-muted leading-relaxed font-light">
        Ember & Ink is not just a review site. It is a curated sanctuary for readers who want to escape into sweeping fantasy romances, or find grounding wisdom in self-help. 
      </p>
    </div>
  </section>

  <!-- 3. Featured Books (Horizontal Scroll / Parallax reveal) -->
  <section class="py-20 bg-paper border-y border-line overflow-hidden">
    <div class="container-ember">
      <div class="flex items-end justify-between gap-4 mb-12 reveal-up">
        <div>
          <h2 class="text-3xl md:text-5xl text-burgundy">Fresh from the shelf</h2>
          <p class="mt-2 text-muted">Hand-picked reviews for your next escape.</p>
        </div>
        <a href="/blog/" class="text-sm font-medium text-burgundy hover:underline shrink-0 hidden md:block">All posts →</a>
      </div>
      
      <!-- Books staggered in -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {others.map((post) => (
          <div class="reveal-card">
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. The Genres (Fade up) -->
  <section class="bg-burgundy text-cream py-24 relative overflow-hidden">
    <!-- Atmospheric background glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gold/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="container-ember relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16 reveal-up">
        <h2 class="text-3xl md:text-5xl text-gold">Explore the Universe</h2>
        <p class="mt-4 text-cream/80 text-lg">Every genre has a corner here. Choose your world.</p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 reveal-up">
        {CATEGORIES.slice(0, 8).map((cat) => (
          <a href={`/categories/${cat.slug}/`} class="group rounded-2xl border border-cream/20 bg-cream/5 p-6 hover:bg-cream/10 hover:border-gold transition-all duration-300">
            <p class="font-display text-xl text-gold group-hover:text-cream transition-colors">{cat.label}</p>
            <p class="mt-2 text-xs text-cream/60 leading-relaxed">{cat.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Fade up text blocks as you scroll
    gsap.utils.toArray<HTMLElement>('.reveal-up').forEach((elem) => {
      gsap.from(elem, {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: elem,
          start: 'top 85%', // Trigger when element is 85% down the viewport
        }
      });
    });

    // Stagger cards in
    gsap.from('.reveal-card', {
      y: 80,
      opacity: 0,
      duration: 1,
      stagger: 0.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.reveal-card',
        start: 'top 85%',
      }
    });

    // Text reveal
    gsap.from('.reveal-text h2', {
      y: 40,
      opacity: 0,
      duration: 1.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.reveal-text',
        start: 'top 80%',
      }
    });
    gsap.from('.reveal-text p', {
      y: 40,
      opacity: 0,
      duration: 1.2,
      delay: 0.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.reveal-text',
        start: 'top 80%',
      }
    });
  });
</script>
