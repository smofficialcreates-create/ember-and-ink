---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import { getPublishedPosts } from '@lib/posts';
import { SITE } from '@lib/site';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="All Reviews & Essays"
  description="Every review and essay on Ember & Ink — self-help, fantasy romance, and beyond. Newest first."
  url={`${SITE.url}/blog/`}
>
  <section class="container-ember py-12 md:py-16">
    <header class="max-w-2xl">
      <p class="text-sm uppercase tracking-[0.2em] text-muted">The journal</p>
      <h1 class="mt-3 text-4xl md:text-5xl text-burgundy">
        All reviews &amp; essays
      </h1>
      <p class="mt-4 text-lg text-muted">
        Every post, newest first — from grounded self-help to sweeping fantasy romance.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-12 text-muted">No posts yet. Check back soon.</p>
    ) : (
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post, i) => (
          <PostCard post={post} eager={i < 3} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>